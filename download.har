          "content": {
            "size": 11957,
            "mimeType": "text/html",
            "text": "<ol class=\"breadcrumb\">\r\n    <li><a href=\"#\" onclick=\"epubs.ShowMainNav(); return false;\">EPUBS Home</a></li>\r\n    <li><a href=\"#\" onclick=\"epubs.SelectCat(20, 'United States Space Force'); return false;\" class=\"bc-cat\">United States Space Force</a></li>\r\n    <li><a href=\"#\" onclick=\"epubs.ShowCurrentSeries(); return false;\" class=\"bc-org\">SF/S2</a></li>\r\n    <li class=\"active bc-series\"></li>\r\n</ol>\r\n\r\n<pub-search-list :publications=\"publications\" />\r\n\r\n<script type=\"text/javascript\">\r\n    Vue.component('pub-search-list', {\r\n        props: ['publications'],\r\n        \r\n        template:\r\n        \"<table id='data' class='epubs-table' style='width:100%'>\" +\r\n        \"    <thead>\" +\r\n        \"       <tr>\" +\r\n        \"            <th class='pnum'>Product Number</th>\" +\r\n        \"            <th class='desktop tablet-l ptitle'>Product Title</th>\" +\r\n        \"            <th class='desktop tablet-l'>Published</th>\" +\r\n        \"            <th class='desktop tablet-l'>Certified Current</th>\" +\r\n        \"            <th class='desktop tablet-l'>Last Action</th>\" +\r\n        \"            <th class='desktop tablet-l'>GM Date</th>\" +\r\n        \"        </tr>\" +\r\n        \"    </thead>\" +\r\n        \"     <tbody>\" +\r\n        \"        <tr v-for='(pub, index) in publications'>\" +\r\n        \"            <td>{{pub.Number}} \" +\r\n        \"                <a target='_blank' rel='noreferrer noopener' :href='pub.DocumentUrl' style='border-bottom:none;' :aria-label=\\\"'PDF of ' + pub.Title\\\" title='Download PDF'><span class='epub-download fa-stack fa-1x'><i class='fas fa-file-pdf fa-stack-2x pdf-icon' ></i><i class='fas fa-arrow-alt-circle-down fa-stack-1x'></i></span></a> \" + \r\n        \"                <a target='_blank' rel='noreferrer noopener' :href='pub.EBookUrl' v-if='pub.EBookPath' style='border-bottom:none;' :aria-label=\\\"'Ebook of ' + pub.Title\\\" title='Download Ebook'><span class='epub-download fa-stack fa-1x'><img src='../DesktopModules/MVC/EPUBS/Resources/ebook/ico_ebook.png' alt='' /><i class='fas fa-arrow-alt-circle-down fa-stack-1x'></i></span></a></td>\" +\r\n        \"            <td><a target='#' class='epub-details' title='View Detail'>{{pub.Title}}</a> </td>\" +\r\n        \"            <td>\" +\r\n        \"                <span class='hide'>{{ pub.Date | formatDate(true) }}</span>\" +\r\n        \"                {{ pub.Date | formatDate(false) }}\" +\r\n        \"            </td>\" +\r\n        \"            <td>\" +\r\n        \"                <span class='hide'>{{ pub.CertDate | formatDate(true) }}</span>\" +\r\n        \"                {{ pub.CertDate | formatDate(false) }}\" +\r\n        \"            </td>\"  +\r\n        \"            <td>{{ pub.LastAction }}</td>\" +\r\n        \"            <td>\" +\r\n        \"                <span class='hide'> {{ pub.LastAction | formatLastAction( pub.GMDate, true) }}</span>\" +\r\n        \"                {{ pub.LastAction | formatLastAction( pub.GMDate, false) }}\" +\r\n        \"            </td>\" +\r\n        \"        </tr>\" +\r\n        \"    </tbody>\" +\r\n        \"</table>\"\r\n    });\r\n\r\n\r\n    Vue.filter('formatDate', function (value, hidden) {\r\n        if (value) {\r\n            var longTime = value.match(/\\d+/)[0] * 1;\r\n            var pubDate = new Date(longTime);\r\n            if (hidden)\r\n                return moment(pubDate).format(\"YYYYMMDD\");\r\n            else\r\n                return moment(pubDate).format(\"DD MMM YYYY\");\r\n        }\r\n\r\n        return \"\";\r\n    });\r\n\r\n    Vue.filter('formatLastAction', function (value, lastActionDate, hidden) {\r\n        if (lastActionDate) {\r\n            var longTime = lastActionDate.match(/\\d+/)[0] * 1;\r\n            var pubDate = new Date(longTime);\r\n            if (hidden)\r\n                return moment(pubDate).format(\"YYYYMMDD\");\r\n            else\r\n                return moment(pubDate).format(\"DD MMM YYYY\");\r\n        }\r\n\r\n        return \"\";\r\n    });\r\n\r\n    var pubSearchApp = new Vue({\r\n        el: '#pub-list',\r\n        component: ['pub-search-list'],\r\n        methods: {\r\n            initPublicationTable: function () {\r\n                return $('#data').DataTable({\r\n                        \"responsive\": true,\r\n                        \"authWidth\": false,\r\n                        \"columnDefs\": [\r\n                            { responsivePriority: 1, targets: 1 },\r\n                            { responsivePriority: 1, targets: 2 }\r\n                        ],\r\n                        \"columns\": [\r\n                            { \"width\": \"15%\", className: \"pubid\" },\r\n                            { \"width\": \"40%\" },\r\n                            null,\r\n                            null,\r\n                            null,\r\n                            null\r\n                        ],\r\n                        \"oLanguage\": {\r\n                            \"sSearch\": \"Filter\"\r\n                        }\r\n                });\r\n            },\r\n        },\r\n        data: {\r\n            publications: [{\"PubID\":90775,\"Number\":\"SPFSOI10-208\",\"Title\":\"U.S. Space Force Continuity of Operations (COOP) Program Operating Instructions\",\"Prescribe\":\"\",\"LastAction\":\"\",\"LastActionDate\":\"\\/Date(1663162397880)\\/\",\"ReplacementID\":0,\"Format\":0,\"ProductType\":0,\"Date\":\"\\/Date(1663128000000)\\/\",\"DocumentPath\":\"/production/1/ussf_coo/publication/spfsoi10-208/spfsoi10-208.pdf\",\"EBookPath\":\"\",\"RescindOrg\":\"SF/S2\",\"RescindDsnPhone\":\"\",\"RescindCommPhone\":\"7036931537\",\"RescindLevel\":\"United States Space Force\",\"CertDate\":\"\\/Date(1663128000000)\\/\",\"GMDate\":null,\"CustomDetail\":false,\"DownloadUrl\":\"https://static.e-publishing.af.mil\",\"DocumentUrl\":\"https://static.e-publishing.af.mil/production/1/ussf_coo/publication/spfsoi10-208/spfsoi10-208.pdf\",\"EBookUrl\":\"https://static.e-publishing.af.mil\",\"FormatLetter\":\"E\",\"FormatClass\":\"label-danger\"},{\"PubID\":268816,\"Number\":\"SPFI16-1002\",\"Title\":\"THREAT MODELING, SIMULATION, AND ANALYSIS GUIDANCE\",\"Prescribe\":\"\",\"LastAction\":\"\",\"LastActionDate\":\"\\/Date(1763650773670)\\/\",\"ReplacementID\":0,\"Format\":0,\"ProductType\":0,\"Date\":\"\\/Date(1763614800000)\\/\",\"DocumentPath\":\"/production/1/sf_s2/publication/spfi16-1002/spfi16-1002.pdf\",\"EBookPath\":\"/production/1/sf_s2/publication/spfi16-1002/spfi16-1002.epub\",\"RescindOrg\":\"SF/S2\",\"RescindDsnPhone\":\"314\",\"RescindCommPhone\":\"7036145031\",\"RescindLevel\":\"United States Space Force\",\"CertDate\":\"\\/Date(1763614800000)\\/\",\"GMDate\":null,\"CustomDetail\":false,\"DownloadUrl\":\"https://static.e-publishing.af.mil\",\"DocumentUrl\":\"https://static.e-publishing.af.mil/production/1/sf_s2/publication/spfi16-1002/spfi16-1002.pdf\",\"EBookUrl\":\"https://static.e-publishing.af.mil/production/1/sf_s2/publication/spfi16-1002/spfi16-1002.epub\",\"FormatLetter\":\"E\",\"FormatClass\":\"label-danger\"},{\"PubID\":268901,\"Number\":\"SPFI14-402\",\"Title\":\"INTELLIGENCE MISSION ROLES, RESPONSIBILITIES, AND PROGRAM MANAGEMENT\",\"Prescribe\":\"\",\"LastAction\":\"Correction\",\"LastActionDate\":\"\\/Date(1770814527967)\\/\",\"ReplacementID\":0,\"Format\":0,\"ProductType\":0,\"Date\":\"\\/Date(1770613200000)\\/\",\"DocumentPath\":\"/production/1/sf_s2/publication/spfi14-402/spfi14-402.pdf\",\"EBookPath\":\"/production/1/sf_s2/publication/spfi14-402/spfi14-402.epub\",\"RescindOrg\":\"SF/S2\",\"RescindDsnPhone\":\"3145170911\",\"RescindCommPhone\":\"7035170911\",\"RescindLevel\":\"United States Space Force\",\"CertDate\":\"\\/Date(1770613200000)\\/\",\"GMDate\":null,\"CustomDetail\":false,\"DownloadUrl\":\"https://static.e-publishing.af.mil\",\"DocumentUrl\":\"https://static.e-publishing.af.mil/production/1/sf_s2/publication/spfi14-402/spfi14-402.pdf\",\"EBookUrl\":\"https://static.e-publishing.af.mil/production/1/sf_s2/publication/spfi14-402/spfi14-402.epub\",\"FormatLetter\":\"E\",\"FormatClass\":\"label-danger\"},{\"PubID\":268910,\"Number\":\"SPfI14-411\",\"Title\":\"SPACE FORCE ACQUISITION INTELLIGENCE\",\"Prescribe\":\"\",\"LastAction\":\"GM\",\"LastActionDate\":\"\\/Date(1776359300813)\\/\",\"ReplacementID\":0,\"Format\":0,\"ProductType\":0,\"Date\":\"\\/Date(1770958800000)\\/\",\"DocumentPath\":\"/production/1/sf_s2/publication/spfi14-411/spi14-411.pdf\",\"EBookPath\":\"\",\"RescindOrg\":\"SF/S2\",\"RescindDsnPhone\":\"314\",\"RescindCommPhone\":\"7036145031\",\"RescindLevel\":\"United States Space Force\",\"CertDate\":\"\\/Date(1770958800000)\\/\",\"GMDate\":\"\\/Date(1776312000000)\\/\",\"CustomDetail\":false,\"DownloadUrl\":\"https://static.e-publishing.af.mil\",\"DocumentUrl\":\"https://static.e-publishing.af.mil/production/1/sf_s2/publication/spfi14-411/spi14-411.pdf\",\"EBookUrl\":\"https://static.e-publishing.af.mil\",\"FormatLetter\":\"E\",\"FormatClass\":\"label-danger\"},{\"PubID\":269110,\"Number\":\"SPFGM2026-14-01\",\"Title\":\"Proper Use of Commercially Available Information (CAI) for United States Space Force (USSF) Intelligence Missions\",\"Prescribe\":\"\",\"LastAction\":\"Correction\",\"LastActionDate\":\"\\/Date(1778180599990)\\/\",\"ReplacementID\":0,\"Format\":0,\"ProductType\":0,\"Date\":\"\\/Date(1778126400000)\\/\",\"DocumentPath\":\"/production/1/sf_s2/publication/spfgm2026-14-01/spfgm2026-14-01.pdf\",\"EBookPath\":\"\",\"RescindOrg\":\"SF/S2\",\"RescindDsnPhone\":\"314\",\"RescindCommPhone\":\"7035714814\",\"RescindLevel\":\"United States Space Force\",\"CertDate\":\"\\/Date(1778126400000)\\/\",\"GMDate\":\"\\/Date(1778126400000)\\/\",\"CustomDetail\":false,\"DownloadUrl\":\"https://static.e-publishing.af.mil\",\"DocumentUrl\":\"https://static.e-publishing.af.mil/production/1/sf_s2/publication/spfgm2026-14-01/spfgm2026-14-01.pdf\",\"EBookUrl\":\"https://static.e-publishing.af.mil\",\"FormatLetter\":\"E\",\"FormatClass\":\"label-danger\"},{\"PubID\":269261,\"Number\":\"SPFGM2026-14-02\",\"Title\":\"Space Force Guidance Memorandum (SPFGM) 2026-14-02, Space Force Intelligence Mission Data\",\"Prescribe\":\"\",\"LastAction\":\"\",\"LastActionDate\":\"\\/Date(1787325080323)\\/\",\"ReplacementID\":0,\"Format\":0,\"ProductType\":0,\"Date\":\"\\/Date(1787284800000)\\/\",\"DocumentPath\":\"/production/1/sf_s2/publication/spfgm2026-14-02/spfgm2026-14-02.pdf\",\"EBookPath\":\"\",\"RescindOrg\":\"SF/S2\",\"RescindDsnPhone\":\"314\",\"RescindCommPhone\":\"7036145031\",\"RescindLevel\":\"United States Space Force\",\"CertDate\":\"\\/Date(1787284800000)\\/\",\"GMDate\":\"\\/Date(1787284800000)\\/\",\"CustomDetail\":false,\"DownloadUrl\":\"https://static.e-publishing.af.mil\",\"DocumentUrl\":\"https://static.e-publishing.af.mil/production/1/sf_s2/publication/spfgm2026-14-02/spfgm2026-14-02.pdf\",\"EBookUrl\":\"https://static.e-publishing.af.mil\",\"FormatLetter\":\"E\",\"FormatClass\":\"label-danger\"},{\"PubID\":269266,\"Number\":\"SPFMD7\",\"Title\":\"NATIONAL SPACE INTELLIGENCE CENTER (NSIC)\",\"Prescribe\":\"\",\"LastAction\":\"\",\"LastActionDate\":\"\\/Date(1787661801100)\\/\",\"ReplacementID\":0,\"Format\":0,\"ProductType\":0,\"Date\":\"\\/Date(1787630400000)\\/\",\"DocumentPath\":\"/production/1/sf_s2/publication/spfmd7/spfmd7.pdf\",\"EBookPath\":\"\",\"RescindOrg\":\"SF/S2\",\"RescindDsnPhone\":\"314\",\"RescindCommPhone\":\"7036145423\",\"RescindLevel\":\"United States Space Force\",\"CertDate\":\"\\/Date(1787630400000)\\/\",\"GMDate\":null,\"CustomDetail\":false,\"DownloadUrl\":\"https://static.e-publishing.af.mil\",\"DocumentUrl\":\"https://static.e-publishing.af.mil/production/1/sf_s2/publication/spfmd7/spfmd7.pdf\",\"EBookUrl\":\"https://static.e-publishing.af.mil\",\"FormatLetter\":\"E\",\"FormatClass\":\"label-danger\"}],\r\n        },\r\n        mounted: function () {\r\n            // Cant init the datatable framework until vue has mounted. This is much better than just\r\n            // setting the setInterval method to fire after some many milliseconds. A lag in\r\n            // rendering would cause the table to display not using the DataTables framework.\r\n            const table = this.initPublicationTable();\r\n            const vueScope = this;\r\n            $('.epubs-table').on('click', '.epub-details', function () {\r\n                // The DOM for mobile vs desktop are constructed differently\r\n                const rowIndex = ($(this).parents('ul').parents('tr').prev().length) ? \r\n                                  table.row($(this).parents('ul').parents('tr').prev()).index() :\r\n                                  table.row($(this).parents('tr')).index();\r\n                const pub = vueScope.publications[rowIndex];\r\n                epubs.ShowPubDetail(pub.PubID , -1, pub.ProductType, 449, 131);\r\n            });\r\n        }\r\n    });\r\n</script>\r\n"
