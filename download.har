            "mimeType": "text/html",
            "text": "<ol class=\"breadcrumb\">\r\n    <li><a href=\"#\" onclick=\"epubs.ShowMainNav(); return false;\">EPUBS Home</a></li>\r\n    <li><a href=\"#\" onclick=\"epubs.SelectCat(3, 'Direct Reporting Units'); return false;\" class=\"bc-cat\">Direct Reporting Units</a></li>\r\n    <li class=\"active bc-org\">United States Air Force Academy</li>\r\n</ol>\r\n    <div class=\"col-lg-12\">\r\n        <h4>Select Publication Series</h4>\r\n        <ul style=\"column-count:2\">\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"ALL PUBLICATIONS\" href=\"#\" onclick=\"epubs.SelectPubs(10256, 3, -1,'ALL PUBLICATIONS', 449, 131);return false;\">00 &nbsp;&nbsp;ALL PUBLICATIONS</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Flying Operations\" href=\"#\" onclick=\"epubs.SelectPubs(10256, 3, 4,'Flying Operations', 449, 131);return false;\">11 &nbsp;&nbsp;Flying Operations</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Nuclear, Space, Missile, Command and Control\" href=\"#\" onclick=\"epubs.SelectPubs(10256, 3, 5,'Nuclear, Space, Missile, Command and Control', 449, 131);return false;\">13 &nbsp;&nbsp;Nuclear, Space, Missile, Command and Control</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Intelligence\" href=\"#\" onclick=\"epubs.SelectPubs(10256, 3, 6,'Intelligence', 449, 131);return false;\">14 &nbsp;&nbsp;Intelligence</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Operations Support\" href=\"#\" onclick=\"epubs.SelectPubs(10256, 3, 8,'Operations Support', 449, 131);return false;\">16 &nbsp;&nbsp;Operations Support</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Cyberspace\" href=\"#\" onclick=\"epubs.SelectPubs(10256, 3, 110,'Cyberspace', 449, 131);return false;\">17 &nbsp;&nbsp;Cyberspace</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Maintenance\" href=\"#\" onclick=\"epubs.SelectPubs(10256, 3, 10,'Maintenance', 449, 131);return false;\">21 &nbsp;&nbsp;Maintenance</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Transportation\" href=\"#\" onclick=\"epubs.SelectPubs(10256, 3, 12,'Transportation', 449, 131);return false;\">24 &nbsp;&nbsp;Transportation</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Security\" href=\"#\" onclick=\"epubs.SelectPubs(10256, 3, 14,'Security', 449, 131);return false;\">31 &nbsp;&nbsp;Security</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Civil Engineering\" href=\"#\" onclick=\"epubs.SelectPubs(10256, 3, 15,'Civil Engineering', 449, 131);return false;\">32 &nbsp;&nbsp;Civil Engineering</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Communications and Information\" href=\"#\" onclick=\"epubs.SelectPubs(10256, 3, 16,'Communications and Information', 449, 131);return false;\">33 &nbsp;&nbsp;Communications and Information</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Services\" href=\"#\" onclick=\"epubs.SelectPubs(10256, 3, 17,'Services', 449, 131);return false;\">34 &nbsp;&nbsp;Services</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Public Affairs\" href=\"#\" onclick=\"epubs.SelectPubs(10256, 3, 18,'Public Affairs', 449, 131);return false;\">35 &nbsp;&nbsp;Public Affairs</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Personnel\" href=\"#\" onclick=\"epubs.SelectPubs(10256, 3, 19,'Personnel', 449, 131);return false;\">36 &nbsp;&nbsp;Personnel</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Manpower And Organization\" href=\"#\" onclick=\"epubs.SelectPubs(10256, 3, 21,'Manpower And Organization', 449, 131);return false;\">38 &nbsp;&nbsp;Manpower And Organization</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Health Services\" href=\"#\" onclick=\"epubs.SelectPubs(10256, 3, 23,'Health Services', 449, 131);return false;\">41 &nbsp;&nbsp;Health Services</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Medical\" href=\"#\" onclick=\"epubs.SelectPubs(10256, 3, 24,'Medical', 449, 131);return false;\">44 &nbsp;&nbsp;Medical</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Dental\" href=\"#\" onclick=\"epubs.SelectPubs(10256, 3, 26,'Dental', 449, 131);return false;\">47 &nbsp;&nbsp;Dental</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Aerospace Medicine\" href=\"#\" onclick=\"epubs.SelectPubs(10256, 3, 27,'Aerospace Medicine', 449, 131);return false;\">48 &nbsp;&nbsp;Aerospace Medicine</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Law\" href=\"#\" onclick=\"epubs.SelectPubs(10256, 3, 28,'Law', 449, 131);return false;\">51 &nbsp;&nbsp;Law</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Chaplain\" href=\"#\" onclick=\"epubs.SelectPubs(10256, 3, 29,'Chaplain', 449, 131);return false;\">52 &nbsp;&nbsp;Chaplain</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Scientific/Research And Development\" href=\"#\" onclick=\"epubs.SelectPubs(10256, 3, 31,'Scientific/Research And Development', 449, 131);return false;\">61 &nbsp;&nbsp;Scientific/Research And Development</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Financial Management\" href=\"#\" onclick=\"epubs.SelectPubs(10256, 3, 35,'Financial Management', 449, 131);return false;\">65 &nbsp;&nbsp;Financial Management</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"History\" href=\"#\" onclick=\"epubs.SelectPubs(10256, 3, 37,'History', 449, 131);return false;\">84 &nbsp;&nbsp;History</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Special Management\" href=\"#\" onclick=\"epubs.SelectPubs(10256, 3, 38,'Special Management', 449, 131);return false;\">90 &nbsp;&nbsp;Special Management</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Safety\" href=\"#\" onclick=\"epubs.SelectPubs(10256, 3, 39,'Safety', 449, 131);return false;\">91 &nbsp;&nbsp;Safety</a></li>\r\n        </ul>\r\n    </div>\r\n        <div style=\"clear:both\"></div>\r\n        <div class=\"col-lg-12\">\r\n            <h4>Special Publications</h4>\r\n            <ul style=\"column-count:2\">\r\n                    <li><span class=\"fa fa-angle-double-right\"></span><a href=\"#\" title=\"Career Field Education and Training Plan\" onclick=\"epubs.SelectPubs(10256, 3, 86, 'Career Field Education and Training Plan', 449, 131);return false;\">CFETP &nbsp;&nbsp;Career Field Education and Training Plan</a></li>\r\n                    <li><span class=\"fa fa-angle-double-right\"></span><a href=\"#\" title=\"Mission Directive\" onclick=\"epubs.SelectPubs(10256, 3, 41, 'Mission Directive', 449, 131);return false;\">MD &nbsp;&nbsp;Mission Directive</a></li>\r\n            </ul>\r\n        </div>\r\n\r\n"
