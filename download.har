spfi13-602v1.pdf\",\"EBookPath\":\"/production/1/sf_coo/publication/spfi13-602v1/spfi13-602v1.epub\",\"RescindOrg\":\"SF/S5/8\",\"RescindDsnPhone\":\"314\",\"RescindCommPhone\":\"5712561227\",\"RescindLevel\":\"United States Space Force\",\"CertDate\":\"\\/Date(1781064000000)\\/\",\"GMDate\":null,\"CustomDetail\":false,\"DownloadUrl\":\"https://static.e-publishing.af.mil\",\"DocumentUrl\":\"https://static.e-publishing.af.mil/production/1/sf_coo/publication/spfi13-602v1/spfi13-602v1.pdf\",\"EBookUrl\":\"https://static.e-publishing.af.mil/production/1/sf_coo/publication/spfi13-602v1/spfi13-602v1.epub\",\"FormatLetter\":\"E\",\"FormatClass\":\"label-danger\"},{\"PubID\":269252,\"Number\":\"SPFI10-202\",\"Title\":\"DOCTRINE, ORGANIZATION, TRAINING, MATERIEL, LEADERSHIP \\u0026 EDUCATION, PERSONNEL, FACILITIES, AND POLICY (DOTMLPF-P) ANALYSIS\",\"Prescribe\":\"\",\"LastAction\":\"\",\"LastActionDate\":\"\\/Date(1786542513057)\\/\",\"ReplacementID\":0,\"Format\":0,\"ProductType\":0,\"Date\":\"\\/Date(1786507200000)\\/\",\"DocumentPath\":\"/production/1/sf_s5_8/publication/spfi10-202/spfi10-202.pdf\",\"EBookPath\":\"\",\"RescindOrg\":\"SF/S5/8\",\"RescindDsnPhone\":\"314\",\"RescindCommPhone\":\"9035133039\",\"RescindLevel\":\"United States Space Force\",\"CertDate\":\"\\/Date(1786507200000)\\/\",\"GMDate\":null,\"CustomDetail\":false,\"DownloadUrl\":\"https://static.e-publishing.af.mil\",\"DocumentUrl\":\"https://static.e-publishing.af.mil/production/1/sf_s5_8/publication/spfi10-202/spfi10-202.pdf\",\"EBookUrl\":\"https://static.e-publishing.af.mil\",\"FormatLetter\":\"E\",\"FormatClass\":\"label-danger\"},{\"PubID\":269287,\"Number\":\"SPFI13-603\",\"Title\":\"Force Design and Development\",\"Prescribe\":\"\",\"LastAction\":\"Rewrite\",\"LastActionDate\":\"\\/Date(1789490916073)\\/\",\"ReplacementID\":0,\"Format\":0,\"ProductType\":0,\"Date\":\"\\/Date(1789444800000)\\/\",\"DocumentPath\":\"/production/1/sf_s5_8/publication/spfi13-603/spfi13-603.pdf\",\"EBookPath\":\"\",