,\"Number\":\"AFPCVA91-100\",\"Title\":\"REPORT ALL MISHAPS AND HAZARDS\",\"Prescribe\":\"\",\"LastAction\":\"Rewrite\",\"LastActionDate\":\"\\/Date(1756232248607)\\/\",\"ReplacementID\":0,\"Format\":0,\"ProductType\":0,\"Date\":\"\\/Date(1755057600000)\\/\",\"DocumentPath\":\"/production/1/afpc/publication/afpcva91-100/afpcva91-100.pdf\",\"EBookPath\":\"\",\"RescindOrg\":\"AFPC\",\"RescindDsnPhone\":\"3126650262\",\"RescindCommPhone\":\"2103861037\",\"RescindLevel\":\"Field Operating Agency\",\"CertDate\":\"\\/Date(1755057600000)\\/\",\"GMDate\":null,\"CustomDetail\":false,\"DownloadUrl\":\"https://static.e-publishing.af.mil\",\"DocumentUrl\":\"https://static.e-publishing.af.mil/production/1/afpc/publication/afpcva91-100/afpcva91-100.pdf\",\"EBookUrl\":\"https://static.e-publishing.af.mil\",\"FormatLetter\":\"E\",\"FormatClass\":\"label-danger\"},{\"PubID\":21729,\"Number\":\"AFPCI36-112\",\"Title\":\"LINE OFFICER INITIAL SKILLS TRAINING RECLASSIFICATION PROCEDURES\",\"Prescribe\":\"\",\"LastAction\":\"CertifiedCurrent\",\"LastActionDate\":\"\\/Date(1704725536317)\\/\",\"ReplacementID\":0,\"Format\":0,\"ProductType\":0,\"Date\":\"\\/Date(1692849600000)\\/\",\"DocumentPath\":\"/production/1/afpc/publication/afpci36-112/afpci36-112.pdf\",\"EBookPath\":\"\",\"RescindOrg\":\"AFPC\",\"RescindDsnPhone\":\"3126650262\",\"RescindCommPhone\":\"2103861037\",\"RescindLevel\":\"Field Operating Agency\",\"CertDate\":\"\\/Date(1704690000000)\\/\",\"GMDate\":null,\"CustomDetail\":false,\"DownloadUrl\":\"https://static.e-publishing.af.mil\",\"DocumentUrl\":\"https://static.e-publishing.af.mil/production/1/afpc/publication/afpci36-112/afpci36-112.pdf\",\"EBookUrl\":\"https://static.e-publishing.af.mil\",\"FormatLetter\":\"E\",\"FormatClass\":\"label-danger\"},{\"PubID\":29451,\"Number\":\"AFPCVA90-100\",\"Title\":\"THE INSPECTOR GENERAL (IG) COMPLAINT PROGRAM\",\"Prescribe\":\"\",\"LastAction\":\"Rewrite\",\"LastActionDate\":\"\\/Date(1789501381170)\\/\",\"ReplacementID\":0,\"Format\":0,\"ProductType\":0,\"Date\":\"\\/Date(1789444800000)\\/\",\"DocumentPath\":\"/production/1/afpc/publication/afpcva90-100/afpcva90-100.pdf\",\"EBookPath\":\"\",\"RescindOrg\":\"AFPC\",\"RescindDsnPhone\":\"3126650262\",\"RescindCommPhone\":\"2103861037\",\"RescindLevel\":\"Field Operating Agency\",\"CertDate\":\"\\/Date(1789444800000)\\/\",\"GMDate\":null,\"CustomDetail\":false,\"DownloadUrl\":\"https://static.e-publishing.af.mil\",\"DocumentUrl\":\"https://static.e-publishing.af.mil/production/1/afpc/publication/afpcva90-100/afpcva90-100.pdf\",\"EBookUrl\":\"https://static.e-publishing.af.mil\",\"FormatLetter\":\"E\",\"FormatClass\":\"label-danger\"},{\"PubID\":29455,\"Number\":\"AFPCI10-100\",\"Title\":\"AIR FORCE PERSONNEL CENTER OPERATIONS CENTER\",\"Prescribe\":\"\",\"LastAction\":\"Rewrite\",\"LastActionDate\":\"\\/Date(1744658834507)\\/\",\"ReplacementID\":0,\"Format\":0,\"ProductType\":0,\"Date\":\"\\/Date(1744603200000)\\/\",\"DocumentPath\":\"/production/1/afpc/publication/afpci10-100/afpci10-100.pdf\",\"EBookPath\":\"/production/1/afpc/publication/afpci10-100/afpci10-100.epub\",\"RescindOrg\":\"AFPC\",\"RescindDsnPhone\":\"3126650262\",\"RescindCommPhone\":\"2103861037\",\"RescindLevel\":\"Field Operating Agency\",\"CertDate\":\"\\/Date(1744603200000)\\/\",\"GMDate\":null,\"CustomDetail\":false,\"DownloadUrl\":\"https://static.e-publishing.af.mil\",\"DocumentUrl\":\"https://static.e-publishing.af.mil/production/1/afpc/publication/afpci10-100/afpci10-100.pdf\",\"EBookUrl\":\"https://static.e-publishing.af.mil/production/1/afpc/publication/afpci10-100/afpci10-100.epub\",\"FormatLetter\":\"E\",\"FormatClass\":\"label-danger\"},{\"PubID\":39488,\"Number\":\"AFPCI33-105\",\"Title\":\"AFPC RECORDS MANAGEMENT PROGRAM\",\"Prescribe\":\"\",\"LastAction\":\"Rewrite\",\"LastActionDate\":\"\\/Date(1734030957113)\\/\",\"ReplacementID\":0,\"Format\":0,\"ProductType\":0,\"Date\":\"\\/Date(1733806800000)\\/\",\"DocumentPath\":\"/production/1/afpc/publication/afpci33-