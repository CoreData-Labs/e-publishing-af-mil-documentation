            "text": "<ol class=\"breadcrumb\">\r\n    <li><a href=\"#\" onclick=\"epubs.ShowMainNav(); return false;\">EPUBS Home</a></li>\r\n    <li><a href=\"#\" onclick=\"epubs.SelectCat(4, 'Field Operating Agencies'); return false;\" class=\"bc-cat\">Field Operating Agencies</a></li>\r\n    <li class=\"active bc-org\">National Air and Space Intelligence Center</li>\r\n</ol>\r\n    <div class=\"col-lg-12\">\r\n        <h4>Select Publication Series</h4>\r\n        <ul style=\"column-count:2\">\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"ALL PUBLICATIONS\" href=\"#\" onclick=\"epubs.SelectPubs(8194, 4, -1,'ALL PUBLICATIONS', 449, 131);return false;\">00 &nbsp;&nbsp;ALL PUBLICATIONS</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Operations\" href=\"#\" onclick=\"epubs.SelectPubs(8194, 4, 3,'Operations', 449, 131);return false;\">10 &nbsp;&nbsp;Operations</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Logistics Staff\" href=\"#\" onclick=\"epubs.SelectPubs(8194, 4, 13,'Logistics Staff', 449, 131);return false;\">25 &nbsp;&nbsp;Logistics Staff</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Communications and Information\" href=\"#\" onclick=\"epubs.SelectPubs(8194, 4, 16,'Communications and Information', 449, 131);return false;\">33 &nbsp;&nbsp;Communications and Information</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Personnel\" href=\"#\" onclick=\"epubs.SelectPubs(8194, 4, 19,'Personnel', 449, 131);return false;\">36 &nbsp;&nbsp;Personnel</a></li>\r\n        </ul>\r\n    </div>\r\n\r\n"
