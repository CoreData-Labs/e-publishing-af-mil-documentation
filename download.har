          "content": {
            "size": 6801,
            "mimeType": "text/html",
            "text": "<ol class=\"breadcrumb\">\r\n    <li><a href=\"#\" onclick=\"epubs.ShowMainNav(); return false;\">EPUBS Home</a></li>\r\n    <li><a href=\"#\" onclick=\"epubs.SelectCat(5, 'Numbered Air Forces'); return false;\" class=\"bc-cat\">Numbered Air Forces</a></li>\r\n    <li><a href=\"#\" onclick=\"epubs.ShowCurrentSeries(); return false;\" class=\"bc-org\">Fifteenth Air Force</a></li>\r\n    <li class=\"active bc-series\"></li>\r\n</ol>\r\n\r\n<pub-search-list :publications=\"publications\" />\r\n\r\n<script type=\"text/javascript\">\r\n    Vue.component('pub-search-list', {\r\n        props: ['publications'],\r\n        \r\n        template:\r\n        \"<table id='data' class='epubs-table' style='width:100%'>\" +\r\n        \"    <thead>\" +\r\n        \"       <tr>\" +\r\n        \"            <th class='pnum'>Product Number</th>\" +\r\n        \"            <th class='desktop tablet-l ptitle'>Product Title</th>\" +\r\n        \"            <th class='desktop tablet-l'>Published</th>\" +\r\n        \"            <th class='desktop tablet-l'>Certified Current</th>\" +\r\n        \"            <th class='desktop tablet-l'>Last Action</th>\" +\r\n        \"            <th class='desktop tablet-l'>GM Date</th>\" +\r\n        \"        </tr>\" +\r\n        \"    </thead>\" +\r\n        \"     <tbody>\" +\r\n        \"        <tr v-for='(pub, index) in publications'>\" +\r\n        \"            <td>{{pub.Number}} \" +\r\n        \"                <a target='_blank' rel='noreferrer noopener' :href='pub.DocumentUrl' style='border-bottom:none;' :aria-label=\\\"'PDF of ' + pub.Title\\\" title='Download PDF'><span class='epub-download fa-stack fa-1x'><i class='fas fa-file-pdf fa-stack-2x pdf-icon' ></i><i class='fas fa-arrow-alt-circle-down fa-stack-1x'></i></span></a> \" + \r\n        \"                <a target='_blank' rel='noreferrer noopener' :href='pub.EBookUrl' v-if='pub.EBookPath' style='border-bottom:none;' :aria-label=\\\"'Ebook of ' + pub.Title\\\" title='Download Ebook'><span class='epub-download fa-stack fa-1x'><img src='../DesktopModules/MVC/EPUBS/Resources/ebook/ico_ebook.png' alt='' /><i class='fas fa-arrow-alt-circle-down fa-stack-1x'></i></span></a></td>\" +\r\n        \"            <td><a target='#' class='epub-details' title='View Detail'>{{pub.Title}}</a> </td>\" +\r\n        \"            <td>\" +\r\n        \"                <span class='hide'>{{ pub.Date | formatDate(true) }}</span>\" +\r\n        \"                {{ pub.Date | formatDate(false) }}\" +\r\n        \"            </td>\" +\r\n        \"            <td>\" +\r\n        \"                <span class='hide'>{{ pub.CertDate | formatDate(true) }}</span>\" +\r\n        \"                {{ pub.CertDate | formatDate(false) }}\" +\r\n        \"            </td>\"  +\r\n        \"            <td>{{ pub.LastAction }}</td>\" +\r\n        \"            <td>\" +\r\n        \"                <span class='hide'> {{ pub.LastAction | formatLastAction( pub.GMDate, true) }}</span>\" +\r\n        \"                {{ pub.LastAction | formatLastAction( pub.GMDate, false) }}\" +\r\n        \"            </td>\" +\r\n        \"        </tr>\" +\r\n        \"    </tbody>\" +\r\n        \"</table>\"\r\n    });\r\n\r\n\r\n    Vue.filter('formatDate', function (value, hidden) {\r\n        if (value) {\r\n            var longTime = value.match(/\\d+/)[0] * 1;\r\n            var pubDate = new Date(longTime);\r\n            if (hidden)\r\n                return moment(pubDate).format(\"YYYYMMDD\");\r\n            else\r\n                return moment(pubDate).format(\"DD MMM YYYY\");\r\n        }\r\n\r\n        return \"\";\r\n    });\r\n\r\n    Vue.filter('formatLastAction', function (value, lastActionDate, hidden) {\r\n        if (lastActionDate) {\r\n            var longTime = lastActionDate.match(/\\d+/)[0] * 1;\r\n            var pubDate = new Date(longTime);\r\n            if (hidden)\r\n                return moment(pubDate).format(\"YYYYMMDD\");\r\n            else\r\n                return moment(pubDate).format(\"DD MMM YYYY\");\r\n        }\r\n\r\n        return \"\";\r\n    });\r\n\r\n    var pubSearchApp = new Vue({\r\n        el: '#pub-list',\r\n        component: ['pub-search-list'],\r\n        methods: {\r\n            initPublicationTable: function () {\r\n                return $('#data').DataTable({\r\n                        \"responsive\": true,\r\n                        \"authWidth\": false,\r\n                        \"columnDefs\": [\r\n                            { responsivePriority: 1, targets: 1 },\r\n                            { responsivePriority: 1, targets: 2 }\r\n                        ],\r\n                        \"columns\": [\r\n                            { \"width\": \"15%\", className: \"pubid\" },\r\n                            { \"width\": \"40%\" },\r\n                            null,\r\n                            null,\r\n                            null,\r\n                            null\r\n                        ],\r\n                        \"oLanguage\": {\r\n                            \"sSearch\": \"Filter\"\r\n                        }\r\n                });\r\n            },\r\n        },\r\n        data: {\r\n            publications: [{\"PubID\":269079,\"Number\":\"AFMAN11-202V2_ACCSUP_15AFSUP\",\"Title\":\"Aircrew Standardization and Evaluation Program\",\"Prescribe\":\"\",\"LastAction\":\"\",\"LastActionDate\":\"\\/Date(1776781045507)\\/\",\"ReplacementID\":0,\"Format\":0,\"ProductType\":0,\"Date\":\"\\/Date(1776744000000)\\/\",\"DocumentPath\":\"/production/1/15af/publication/afman11-202v2_accsup_15afsup/afman11-202v2_accsup_15afsup.pdf\",\"EBookPath\":\"\",\"RescindOrg\":\"15AF\",\"RescindDsnPhone\":\"3128852093\",\"RescindCommPhone\":\"8038852093\",\"RescindLevel\":\"Numbered AF\",\"CertDate\":\"\\/Date(1776744000000)\\/\",\"GMDate\":null,\"CustomDetail\":false,\"DownloadUrl\":\"https://static.e-publishing.af.mil\",\"DocumentUrl\":\"https://static.e-publishing.af.mil/production/1/15af/publication/afman11-202v2_accsup_15afsup/afman11-202v2_accsup_15afsup.pdf\",\"EBookUrl\":\"https://static.e-publishing.af.mil\",\"FormatLetter\":\"E\",\"FormatClass\":\"label-danger\"}],\r\n        },\r\n        mounted: function () {\r\n            // Cant init the datatable framework until vue has mounted. This is much better than just\r\n            // setting the setInterval method to fire after some many milliseconds. A lag in\r\n            // rendering would cause the table to display not using the DataTables framework.\r\n            const table = this.initPublicationTable();\r\n            const vueScope = this;\r\n            $('.epubs-table').on('click', '.epub-details', function () {\r\n                // The DOM for mobile vs desktop are constructed differently\r\n                const rowIndex = ($(this).parents('ul').parents('tr').prev().length) ? \r\n                                  table.row($(this).parents('ul').parents('tr').prev()).index() :\r\n                                  table.row($(this).parents('tr')).index();\r\n                const pub = vueScope.publications[rowIndex];\r\n                epubs.ShowPubDetail(pub.PubID , -1, pub.ProductType, 449, 131);\r\n            });\r\n        }\r\n    });\r\n</script>\r\n"
          },
