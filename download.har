          "content": {
            "size": 5165,
            "mimeType": "text/html",
            "text": "<ol class=\"breadcrumb\">\r\n    <li><a href=\"#\" onclick=\"epubs.ShowMainNav(); return false;\">EPUBS Home</a></li>\r\n    <li><a href=\"#\" onclick=\"epubs.SelectCat(16, 'Air National Guard'); return false;\" class=\"bc-cat\">Air National Guard</a></li>\r\n    <li class=\"active bc-org\">Air National Guard</li>\r\n</ol>\r\n    <div class=\"col-lg-12\">\r\n        <h4>Select Publication Series</h4>\r\n        <ul style=\"column-count:2\">\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"ALL PUBLICATIONS\" href=\"#\" onclick=\"epubs.SelectPubs(44, 16, -1,'ALL PUBLICATIONS', 449, 131);return false;\">00 &nbsp;&nbsp;ALL PUBLICATIONS</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Operations\" href=\"#\" onclick=\"epubs.SelectPubs(44, 16, 3,'Operations', 449, 131);return false;\">10 &nbsp;&nbsp;Operations</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Flying Operations\" href=\"#\" onclick=\"epubs.SelectPubs(44, 16, 4,'Flying Operations', 449, 131);return false;\">11 &nbsp;&nbsp;Flying Operations</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Nuclear, Space, Missile, Command and Control\" href=\"#\" onclick=\"epubs.SelectPubs(44, 16, 5,'Nuclear, Space, Missile, Command and Control', 449, 131);return false;\">13 &nbsp;&nbsp;Nuclear, Space, Missile, Command and Control</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Operations Support\" href=\"#\" onclick=\"epubs.SelectPubs(44, 16, 8,'Operations Support', 449, 131);return false;\">16 &nbsp;&nbsp;Operations Support</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Cyberspace\" href=\"#\" onclick=\"epubs.SelectPubs(44, 16, 110,'Cyberspace', 449, 131);return false;\">17 &nbsp;&nbsp;Cyberspace</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Maintenance\" href=\"#\" onclick=\"epubs.SelectPubs(44, 16, 10,'Maintenance', 449, 131);return false;\">21 &nbsp;&nbsp;Maintenance</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Materiel Management\" href=\"#\" onclick=\"epubs.SelectPubs(44, 16, 11,'Materiel Management', 449, 131);return false;\">23 &nbsp;&nbsp;Materiel Management</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Security\" href=\"#\" onclick=\"epubs.SelectPubs(44, 16, 14,'Security', 449, 131);return false;\">31 &nbsp;&nbsp;Security</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Civil Engineering\" href=\"#\" onclick=\"epubs.SelectPubs(44, 16, 15,'Civil Engineering', 449, 131);return false;\">32 &nbsp;&nbsp;Civil Engineering</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Services\" href=\"#\" onclick=\"epubs.SelectPubs(44, 16, 17,'Services', 449, 131);return false;\">34 &nbsp;&nbsp;Services</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Personnel\" href=\"#\" onclick=\"epubs.SelectPubs(44, 16, 19,'Personnel', 449, 131);return false;\">36 &nbsp;&nbsp;Personnel</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Medical Command\" href=\"#\" onclick=\"epubs.SelectPubs(44, 16, 22,'Medical Command', 449, 131);return false;\">40 &nbsp;&nbsp;Medical Command</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Health Services\" href=\"#\" onclick=\"epubs.SelectPubs(44, 16, 23,'Health Services', 449, 131);return false;\">41 &nbsp;&nbsp;Health Services</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Law\" href=\"#\" onclick=\"epubs.SelectPubs(44, 16, 28,'Law', 449, 131);return false;\">51 &nbsp;&nbsp;Law</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Acquisition\" href=\"#\" onclick=\"epubs.SelectPubs(44, 16, 33,'Acquisition', 449, 131);return false;\">63 &nbsp;&nbsp;Acquisition</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Financial Management\" href=\"#\" onclick=\"epubs.SelectPubs(44, 16, 35,'Financial Management', 449, 131);return false;\">65 &nbsp;&nbsp;Financial Management</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Special Management\" href=\"#\" onclick=\"epubs.SelectPubs(44, 16, 38,'Special Management', 449, 131);return false;\">90 &nbsp;&nbsp;Special Management</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Safety\" href=\"#\" onclick=\"epubs.SelectPubs(44, 16, 39,'Safety', 449, 131);return false;\">91 &nbsp;&nbsp;Safety</a></li>\r\n        </ul>\r\n    </div>\r\n        <div style=\"clear:both\"></div>\r\n        <div class=\"col-lg-12\">\r\n            <h4>Special Publications</h4>\r\n            <ul style=\"column-count:2\">\r\n                    <li><span class=\"fa fa-angle-double-right\"></span><a href=\"#\" title=\"Career Field Education and Training Plan\" onclick=\"epubs.SelectPubs(44, 16, 86, 'Career Field Education and Training Plan', 449, 131);return false;\">CFETP &nbsp;&nbsp;Career Field Education and Training Plan</a></li>\r\n            </ul>\r\n        </div>\r\n\r\n"
