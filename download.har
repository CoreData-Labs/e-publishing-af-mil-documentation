\":\"8057579134\",\"RescindLevel\":\"United States Space Force\",\"CertDate\":\"\\/Date(1769749200000)\\/\",\"GMDate\":\"\\/Date(1769749200000)\\/\",\"CustomDetail\":false,\"DownloadUrl\":\"https://static.e-publishing.af.mil\",\"DocumentUrl\":\"https://static.e-publishing.af.mil/production/1/ussf/publication/spgm2026-36-01/spfgm2026-36-01.pdf\",\"EBookUrl\":\"https://static.e-publishing.af.mil\",\"FormatLetter\":\"E\",\"FormatClass\":\"label-danger\"},{\"PubID\":269176,\"Number\":\"SPFSOI90-1\",\"Title\":\"Space Force Staff Battle Rhythm Operating Instruction\",\"Prescribe\":\"\",\"LastAction\":\"\",\"LastActionDate\":\"\\/Date(1781100070677)\\/\",\"ReplacementID\":0,\"Format\":0,\"ProductType\":0,\"Date\":\"\\/Date(1781064000000)\\/\",\"DocumentPath\":\"/production/1/ussf/publication/spfsoi90-1/spfsoi90-01.pdf\",\"EBookPath\":\"\",\"RescindOrg\":\"USSF\",\"RescindDsnPhone\":\"3145455558\",\"RescindCommPhone\":\"\",\"RescindLevel\":\"United States Space Force\",\"CertDate\":\"\\/Date(1781064000000)\\/\",\"GMDate\":null,\"CustomDetail\":false,\"DownloadUrl\":\"https://static.e-publishing.af.mil\",\"DocumentUrl\":\"https://static.e-publishing.af.mil/production/1/ussf/publication/spfsoi90-1/spfsoi90-01.pdf\",\"EBookUrl\":\"https://static.e-publishing.af.mil\",\"FormatLetter\":\"E\",\"FormatClass\":\"label-danger\"},{\"PubID\":269237,\"Number\":\"SPFGM2026-36-01\",\"Title\":\"Space Force Memorandum for Implementation of Guardians on Sustained Duty and Not on Sustained Duty in the United States Space Force\",\"Prescribe\":\"\",\"LastAction\":\"Rewrite\",\"LastActionDate\":\"\\/Date(1785434029833)\\/\",\"ReplacementID\":0,\"Format\":0,\"ProductType\":0,\"Date\":\"\\/Date(1753934400000)\\/\",\"DocumentPath\":\"/production/1/ussf/publication/spfgm2026-36-01/spfgm2026-36-01.pdf\",\"EBookPath\":\"\",\"RescindOrg\":\"USSF\",\"RescindDsnPhone\":\"3143723510\",\"RescindCommPhone\":\"5713723510\",\"RescindLevel\":\"United States Space Force\",\"CertDate\":\"\\/Date(1753934400000)\\/\",\"GMDate\":null,\"CustomDetail\":false,\"DownloadUrl\":\"https://static.e-publishing.af.mil\",\"DocumentUrl\":\"https://static.e-publishing.af.mil/production/1/ussf/publication/spfgm2026-36-01/spfgm2026-36-01.pdf\",\"EBookUrl\":\"https://static.e-publishing.af.mil\",\"FormatLetter\":\"E\",\"FormatClass\":\"label-danger\"}],\r\n        },\r\n        mounted: function () {\r\n            // Cant init the datatable framework until vue has mounted. This is much better than just\r\n            // setting the setInterval method to fire after some many milliseconds. A lag in\r\n            // rendering would cause the table to display not using the DataTables framework.\r\n            const table = this.initPublicationTable();\r\n            const vueScope = this;\r\n            $('.epubs-table').on('click', '.epub-details', function () {\r\n                // The DOM for mobile vs desktop are constructed differently\r\n                const rowIndex = ($(this).parents('ul').parents('tr').prev().length) ? \r\n                                  table.row($(this).parents('ul').parents('tr').prev()).index() :\r\n                                  table.row($(this).parents('tr')).index();\r\n                const pub = vueScope.publications[rowIndex];\r\n                epubs.ShowPubDetail(pub.PubID , -1, pub.ProductType, 449, 131);\r\n            });\r\n        }\r\n    });\r\n</script>\r\n"
