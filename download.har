          "content": {
            "size": 4347,
            "mimeType": "text/html",
            "text": "<ol class=\"breadcrumb\">\r\n    <li><a href=\"#\" onclick=\"epubs.ShowMainNav(); return false;\">EPUBS Home</a></li>\r\n    <li><a href=\"#\" onclick=\"epubs.SelectCat(4, 'Field Operating Agencies'); return false;\" class=\"bc-cat\">Field Operating Agencies</a></li>\r\n    <li class=\"active bc-org\">Air Force Office of Special Investigations</li>\r\n</ol>\r\n    <div class=\"col-lg-12\">\r\n        <h4>Select Publication Series</h4>\r\n        <ul style=\"column-count:2\">\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"ALL PUBLICATIONS\" href=\"#\" onclick=\"epubs.SelectPubs(33, 4, -1,'ALL PUBLICATIONS', 449, 131);return false;\">00 &nbsp;&nbsp;ALL PUBLICATIONS</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Operations\" href=\"#\" onclick=\"epubs.SelectPubs(33, 4, 3,'Operations', 449, 131);return false;\">10 &nbsp;&nbsp;Operations</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Logistics\" href=\"#\" onclick=\"epubs.SelectPubs(33, 4, 9,'Logistics', 449, 131);return false;\">20 &nbsp;&nbsp;Logistics</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Security\" href=\"#\" onclick=\"epubs.SelectPubs(33, 4, 14,'Security', 449, 131);return false;\">31 &nbsp;&nbsp;Security</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Communications and Information\" href=\"#\" onclick=\"epubs.SelectPubs(33, 4, 16,'Communications and Information', 449, 131);return false;\">33 &nbsp;&nbsp;Communications and Information</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Public Affairs\" href=\"#\" onclick=\"epubs.SelectPubs(33, 4, 18,'Public Affairs', 449, 131);return false;\">35 &nbsp;&nbsp;Public Affairs</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Personnel\" href=\"#\" onclick=\"epubs.SelectPubs(33, 4, 19,'Personnel', 449, 131);return false;\">36 &nbsp;&nbsp;Personnel</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Manpower And Organization\" href=\"#\" onclick=\"epubs.SelectPubs(33, 4, 21,'Manpower And Organization', 449, 131);return false;\">38 &nbsp;&nbsp;Manpower And Organization</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Law\" href=\"#\" onclick=\"epubs.SelectPubs(33, 4, 28,'Law', 449, 131);return false;\">51 &nbsp;&nbsp;Law</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Special Investigations\" href=\"#\" onclick=\"epubs.SelectPubs(33, 4, 36,'Special Investigations', 449, 131);return false;\">71 &nbsp;&nbsp;Special Investigations</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"History\" href=\"#\" onclick=\"epubs.SelectPubs(33, 4, 37,'History', 449, 131);return false;\">84 &nbsp;&nbsp;History</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Special Management\" href=\"#\" onclick=\"epubs.SelectPubs(33, 4, 38,'Special Management', 449, 131);return false;\">90 &nbsp;&nbsp;Special Management</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Safety\" href=\"#\" onclick=\"epubs.SelectPubs(33, 4, 39,'Safety', 449, 131);return false;\">91 &nbsp;&nbsp;Safety</a></li>\r\n        </ul>\r\n    </div>\r\n        <div style=\"clear:both\"></div>\r\n        <div class=\"col-lg-12\">\r\n            <h4>Special Publications</h4>\r\n            <ul style=\"column-count:2\">\r\n                    <li><span class=\"fa fa-angle-double-right\"></span><a href=\"#\" title=\"Air Force Job Qualification Standard\" onclick=\"epubs.SelectPubs(33, 4, 82, 'Air Force Job Qualification Standard', 449, 131);return false;\">AFJQS &nbsp;&nbsp;Air Force Job Qualification Standard</a></li>\r\n                    <li><span class=\"fa fa-angle-double-right\"></span><a href=\"#\" title=\"Career Field Education and Training Plan\" onclick=\"epubs.SelectPubs(33, 4, 86, 'Career Field Education and Training Plan', 449, 131);return false;\">CFETP &nbsp;&nbsp;Career Field Education and Training Plan</a></li>\r\n                    <li><span class=\"fa fa-angle-double-right\"></span><a href=\"#\" title=\"Mission Directive\" onclick=\"epubs.SelectPubs(33, 4, 41, 'Mission Directive', 449, 131);return false;\">MD &nbsp;&nbsp;Mission Directive</a></li>\r\n            </ul>\r\n        </div>\r\n\r\n"
