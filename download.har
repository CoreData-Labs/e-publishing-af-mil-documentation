"UpdateContact\",\"LastActionDate\":\"\\/Date(1783346173703)\\/\",\"ReplacementID\":0,\"Format\":0,\"ProductType\":0,\"Date\":\"\\/Date(1782446400000)\\/\",\"DocumentPath\":\"/production/1/ussf_coo/publication/cfept5s0x1/cfept5s0x1.pdf\",\"EBookPath\":\"\",\"RescindOrg\":\"SF/S347\",\"RescindDsnPhone\":\"3122236559\",\"RescindCommPhone\":\"7035716559\",\"RescindLevel\":\"United States Space Force\",\"CertDate\":\"\\/Date(1782446400000)\\/\",\"GMDate\":null,\"CustomDetail\":false,\"DownloadUrl\":\"https://static.e-publishing.af.mil\",\"DocumentUrl\":\"https://static.e-publishing.af.mil/production/1/ussf_coo/publication/cfept5s0x1/cfept5s0x1.pdf\",\"EBookUrl\":\"https://static.e-publishing.af.mil\",\"FormatLetter\":\"E\",\"FormatClass\":\"label-danger\"},{\"PubID\":269309,\"Number\":\"SPFMAN63-142\",\"Title\":\"Weapon System Sustainment Portfolio Procedures\",\"Prescribe\":\"\",\"LastAction\":\"\",\"LastActionDate\":\"\\/Date(1790859566673)\\/\",\"ReplacementID\":0,\"Format\":0,\"ProductType\":0,\"Date\":\"\\/Date(1790827200000)\\/\",\"DocumentPath\":\"/production/1/sf_s347/publication/spfman63-142/spfman63-142.pdf\",\"EBookPath\":\"\",\"RescindOrg\":\"SF/S347\",\"RescindDsnPhone\":\"314\",\"RescindCommPhone\":\"\",\"RescindLevel\":\"United States Space Force\",\"CertDate\":\"\\/Date(1790827200000)\\/\",\"GMDate\":null,\"CustomDetail\":false,\"DownloadUrl\":\"https://static.e-publishing.af.mil\",\"DocumentUrl\":\"https://static.e-publishing.af.mil/production/1/sf_s347/publication/spfman63-142/spfman63-142.pdf\",\"EBookUrl\":\"https://static.e-publishing.af.mil\",\"FormatLetter\":\"E\",\"FormatClass\":\"label-danger\"}],\r\n        },\r\n        mounted: function () {\r\n            // Cant init the datatable framework until vue has mounted. This is much better than just\r\n            // setting the setInterval method to fire after some many milliseconds. A lag in\r\n            // rendering would cause the table to display not using the DataTables framework.\r\n            const table = this.initPublicationTable();\r\n            const vueScope = this;\r\n            $('.epubs-table').on('click', '.epub-details', function () {\r\n                // The DOM for mobile vs desktop are constructed differently\r\n                const rowIndex = ($(this).parents('ul').parents('tr').prev().length) ? \r\n                                  table.row($(this).parents('ul').parents('tr').prev()).index() :\r\n                                  table.row($(this).parents('tr')).index();\r\n                const pub = vueScope.publications[rowIndex];\r\n                epubs.ShowPubDetail(pub.PubID , -1, pub.ProductType, 449, 131);\r\n            });\r\n        }\r\n    });\r\n</script>\r\n"
