ndLevel\":\"Field Operating Agency\",\"CertDate\":\"\\/Date(1713758400000)\\/\",\"GMDate\":null,\"CustomDetail\":false,\"DownloadUrl\":\"https://static.e-publishing.af.mil\",\"DocumentUrl\":\"https://static.e-publishing.af.mil/production/1/afpc/publication/afpci36-115/afpci36-115.pdf\",\"EBookUrl\":\"https://static.e-publishing.af.mil\",\"FormatLetter\":\"E\",\"FormatClass\":\"label-danger\"},{\"PubID\":268763,\"Number\":\"AFPCI36-147\",\"Title\":\"CIVILIAN DRESS AND APPEARANCE STANDARDS\",\"Prescribe\":\"\",\"LastAction\":\"\",\"LastActionDate\":\"\\/Date(1756408324673)\\/\",\"ReplacementID\":0,\"Format\":0,\"ProductType\":0,\"Date\":\"\\/Date(1756180800000)\\/\",\"DocumentPath\":\"/production/1/afpc/publication/afpci36-147/afpci36-147.pdf\",\"EBookPath\":\"\",\"RescindOrg\":\"AFPC\",\"RescindDsnPhone\":\"3126650262\",\"RescindCommPhone\":\"2103861037\",\"RescindLevel\":\"Field Operating Agency\",\"CertDate\":\"\\/Date(1756180800000)\\/\",\"GMDate\":null,\"CustomDetail\":false,\"DownloadUrl\":\"https://static.e-publishing.af.mil\",\"DocumentUrl\":\"https://static.e-publishing.af.mil/production/1/afpc/publication/afpci36-147/afpci36-147.pdf\",\"EBookUrl\":\"https://static.e-publishing.af.mil\",\"FormatLetter\":\"E\",\"FormatClass\":\"label-danger\"}],\r\n        },\r\n        mounted: function () {\r\n            // Cant init the datatable framework until vue has mounted. This is much better than just\r\n            // setting the setInterval method to fire after some many milliseconds. A lag in\r\n            // rendering would cause the table to display not using the DataTables framework.\r\n            const table = this.initPublicationTable();\r\n            const vueScope = this;\r\n            $('.epubs-table').on('click', '.epub-details', function () {\r\n                // The DOM for mobile vs desktop are constructed differently\r\n                const rowIndex = ($(this).parents('ul').parents('tr').prev().length) ? \r\n                                  table.row($(this).parents('ul').parents('tr').prev()).index() :\r\n                                  table.row($(this).parents('tr')).index();\r\n                const pub = vueScope.publications[rowIndex];\r\n                epubs.ShowPubDetail(pub.PubID , -1, pub.ProductType, 449, 131);\r\n            });\r\n        }\r\n    });\r\n</script>\r\n"
