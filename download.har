            "mimeType": "text/html",
            "text": "<ol class=\"breadcrumb\">\r\n    <li><a href=\"#\" onclick=\"epubs.ShowMainNav(); return false;\">EPUBS Home</a></li>\r\n    <li><a href=\"#\" onclick=\"epubs.SelectCat(2, 'Major Commands'); return false;\" class=\"bc-cat\">Major Commands</a></li>\r\n    <li class=\"active bc-org\">Air Force Materiel Command</li>\r\n</ol>\r\n    <div class=\"col-lg-12\">\r\n        <h4>Select Publication Series</h4>\r\n        <ul style=\"column-count:2\">\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"ALL PUBLICATIONS\" href=\"#\" onclick=\"epubs.SelectPubs(4, 2, -1,'ALL PUBLICATIONS', 449, 131);return false;\">00 &nbsp;&nbsp;ALL PUBLICATIONS</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Operations\" href=\"#\" onclick=\"epubs.SelectPubs(4, 2, 3,'Operations', 449, 131);return false;\">10 &nbsp;&nbsp;Operations</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Flying Operations\" href=\"#\" onclick=\"epubs.SelectPubs(4, 2, 4,'Flying Operations', 449, 131);return false;\">11 &nbsp;&nbsp;Flying Operations</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Nuclear, Space, Missile, Command and Control\" href=\"#\" onclick=\"epubs.SelectPubs(4, 2, 5,'Nuclear, Space, Missile, Command and Control', 449, 131);return false;\">13 &nbsp;&nbsp;Nuclear, Space, Missile, Command and Control</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Weather\" href=\"#\" onclick=\"epubs.SelectPubs(4, 2, 7,'Weather', 449, 131);return false;\">15 &nbsp;&nbsp;Weather</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Operations Support\" href=\"#\" onclick=\"epubs.SelectPubs(4, 2, 8,'Operations Support', 449, 131);return false;\">16 &nbsp;&nbsp;Operations Support</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Logistics\" href=\"#\" onclick=\"epubs.SelectPubs(4, 2, 9,'Logistics', 449, 131);return false;\">20 &nbsp;&nbsp;Logistics</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Maintenance\" href=\"#\" onclick=\"epubs.SelectPubs(4, 2, 10,'Maintenance', 449, 131);return false;\">21 &nbsp;&nbsp;Maintenance</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Materiel Management\" href=\"#\" onclick=\"epubs.SelectPubs(4, 2, 11,'Materiel Management', 449, 131);return false;\">23 &nbsp;&nbsp;Materiel Management</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Transportation\" href=\"#\" onclick=\"epubs.SelectPubs(4, 2, 12,'Transportation', 449, 131);return false;\">24 &nbsp;&nbsp;Transportation</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Security\" href=\"#\" onclick=\"epubs.SelectPubs(4, 2, 14,'Security', 449, 131);return false;\">31 &nbsp;&nbsp;Security</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Personnel\" href=\"#\" onclick=\"epubs.SelectPubs(4, 2, 19,'Personnel', 449, 131);return false;\">36 &nbsp;&nbsp;Personnel</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Manpower And Organization\" href=\"#\" onclick=\"epubs.SelectPubs(4, 2, 21,'Manpower And Organization', 449, 131);return false;\">38 &nbsp;&nbsp;Manpower And Organization</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Law\" href=\"#\" onclick=\"epubs.SelectPubs(4, 2, 28,'Law', 449, 131);return false;\">51 &nbsp;&nbsp;Law</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Standardization\" href=\"#\" onclick=\"epubs.SelectPubs(4, 2, 30,'Standardization', 449, 131);return false;\">60 &nbsp;&nbsp;Standardization</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Scientific/Research And Development\" href=\"#\" onclick=\"epubs.SelectPubs(4, 2, 31,'Scientific/Research And Development', 449, 131);return false;\">61 &nbsp;&nbsp;Scientific/Research And Development</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Developmental Engineering\" href=\"#\" onclick=\"epubs.SelectPubs(4, 2, 32,'Developmental Engineering', 449, 131);return false;\">62 &nbsp;&nbsp;Developmental Engineering</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Acquisition\" href=\"#\" onclick=\"epubs.SelectPubs(4, 2, 33,'Acquisition', 449, 131);return false;\">63 &nbsp;&nbsp;Acquisition</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Contracting\" href=\"#\" onclick=\"epubs.SelectPubs(4, 2, 34,'Contracting', 449, 131);return false;\">64 &nbsp;&nbsp;Contracting</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Financial Management\" href=\"#\" onclick=\"epubs.SelectPubs(4, 2, 35,'Financial Management', 449, 131);return false;\">65 &nbsp;&nbsp;Financial Management</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Special Management\" href=\"#\" onclick=\"epubs.SelectPubs(4, 2, 38,'Special Management', 449, 131);return false;\">90 &nbsp;&nbsp;Special Management</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Safety\" href=\"#\" onclick=\"epubs.SelectPubs(4, 2, 39,'Safety', 449, 131);return false;\">91 &nbsp;&nbsp;Safety</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Test And Evaluation\" href=\"#\" onclick=\"epubs.SelectPubs(4, 2, 40,'Test And Evaluation', 449, 131);return false;\">99 &nbsp;&nbsp;Test And Evaluation</a></li>\r\n        </ul>\r\n    </div>\r\n        <div style=\"clear:both\"></div>\r\n        <div class=\"col-lg-12\">\r\n            <h4