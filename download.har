          "content": {
            "size": 13447,
            "mimeType": "text/html",
            "text": "<ol class=\"breadcrumb\">\r\n    <li><a href=\"#\" onclick=\"epubs.ShowMainNav(); return false;\">EPUBS Home</a></li>\r\n    <li><a href=\"#\" onclick=\"epubs.SelectCat(20, 'United States Space Force'); return false;\" class=\"bc-cat\">United States Space Force</a></li>\r\n    <li><a href=\"#\" onclick=\"epubs.ShowCurrentSeries(); return false;\" class=\"bc-org\">Headquarters Space Force</a></li>\r\n    <li class=\"active bc-series\"></li>\r\n</ol>\r\n\r\n<pub-search-list :publications=\"publications\" />\r\n\r\n<script type=\"text/javascript\">\r\n    Vue.component('pub-search-list', {\r\n        props: ['publications'],\r\n        \r\n        template:\r\n        \"<table id='data' class='epubs-table' style='width:100%'>\" +\r\n        \"    <thead>\" +\r\n        \"       <tr>\" +\r\n        \"            <th class='pnum'>Product Number</th>\" +\r\n        \"            <th class='desktop tablet-l ptitle'>Product Title</th>\" +\r\n        \"            <th class='desktop tablet-l'>Published</th>\" +\r\n        \"            <th class='desktop tablet-l'>Certified Current</th>\" +\r\n        \"            <th class='desktop tablet-l'>Last Action</th>\" +\r\n        \"            <th class='desktop tablet-l'>GM Date</th>\" +\r\n        \"        </tr>\" +\r\n        \"    </thead>\" +\r\n        \"     <tbody>\" +\r\n        \"        <tr v-for='(pub, index) in publications'>\" +\r\n        \"            <td>{{pub.Number}} \" +\r\n        \"                <a target='_blank' rel='noreferrer noopener' :href='pub.DocumentUrl' style='border-bottom:none;' :aria-label=\\\"'PDF of ' + pub.Title\\\" title='Download PDF'><span class='epub-download fa-stack fa-1x'><i class='fas fa-file-pdf fa-stack-2x pdf-icon' ></i><i class='fas fa-arrow-alt-circle-down fa-stack-1x'></i></span></a> \" + \r\n        \"                <a target='_blank' rel='noreferrer noopener' :href='pub.EBookUrl' v-if='pub.EBookPath' style='border-bottom:none;' :aria-label=\\\"'Ebook of ' + pub.Title\\\" title='Download Ebook'><span class='epub-download fa-stack fa-1x'><img src='../DesktopModules/MVC/EPUBS/Resources/ebook/ico_ebook.png' alt='' /><i class='fas fa-arrow-alt-circle-down fa-stack-1x'></i></span></a></td>\" +\r\n        \"            <td><a target='#' class='epub-details' title='View Detail'>{{pub.Title}}</a> </td>\" +\r\n        \"            <td>\" +\r\n        \"                <span class='hide'>{{ pub.Date | formatDate(true) }}</span>\" +\r\n        \"                {{ pub.Date | formatDate(false) }}\" +\r\n        \"            </td>\" +\r\n        \"            <td>\" +\r\n        \"                <span class='hide'>{{ pub.CertDate | formatDate(true) }}</span>\" +\r\n        \"                {{ pub.CertDate | formatDate(false) }}\" +\r\n        \"            </td>\"  +\r\n        \"            <td>{{ pub.LastAction }}</td>\" +\r\n        \"            <td>\" +\r\n        \"                <span class='hide'> {{ pub.LastAction | formatLastAction( pub.GMDate, true) }}</span>\" +\r\n        \"                {{ pub.LastAction | formatLastAction( pub.GMDate, false) }}\" +\r\n        \"            </td>\" +\r\n        \"        </tr>\" +\r\n        \"    </tbody>\" +\r\n        \"</table>\"\r\n    });\r\n\r\n\r\n    Vue.filter('formatDate', function (value, hidden) {\r\n        if (value) {\r\n            var longTime = value.match(/\\d+/)[0] * 1;\r\n            var pubDate = new Date(longTime);\r\n            if (hidden)\r\n                return moment(pubDate).format(\"YYYYMMDD\");\r\n            else\r\n                return moment(pubDate).format(\"DD MMM YYYY\");\r\n        }\r\n\r\n        return \"\";\r\n    });\r\n\r\n    Vue.filter('formatLastAction', function (value, lastActionDate, hidden) {\r\n        if (lastActionDate) {\r\n            var longTime = lastActionDate.match(/\\d+/)[0] * 1;\r\n            var pubDate = new Date(longTime);\r\n            if (hidden)\r\n                return moment(pubDate).format(\"YYYYMMDD\");\r\n            else\r\n                return moment(pubDate).format(\"DD MMM YYYY\");\r\n        }\r\n\r\n        return \"\";\r\n    });\r\n\r\n    var pubSearchApp = new Vue({\r\n        el: '#pub-list',\r\n        component: ['pub-search-list'],\r\n        methods: {\r\n            initPublicationTable: function () {\r\n                return $('#data').DataTable({\r\n                        \"responsive\": true,\r\n                        \"authWidth\": false,\r\n                        \"columnDefs\": [\r\n                            { responsivePriority: 1, targets: 1 },\r\n                            { responsivePriority: 1, targets: 2 }\r\n                        ],\r\n                        \"columns\": [\r\n                            { \"width\": \"15%\", className: \"pubid\" },\r\n                            { \"width\": \"40%\" },\r\n                            null,\r\n                            null,\r\n                            null,\r\n                            null\r\n                        ],\r\n                        \"oLanguage\": {\r\n                            \"sSearch\": \"Filter\"\r\n                        }\r\n                });\r\n            },\r\n        },\r\n        data: {\r\n            publications: [{\"PubID\":91259,\"Number\":\"HAFMD2-2\",\"Title\":\"OFFICE OF THE CHIEF OF SPACE OPERATIONS DIRECTOR OF STAFF\",\"Prescribe\":\"\",\"LastAction\":\"Correction\",\"LastActionDate\":\"\\/Date(1679422303460)\\/\",\"ReplacementID\":0,\"Format\":0,\"ProductType\":0,\"Date\":\"\\/Date(1679284800000)\\/\",\"DocumentPath\":\"/production/1/hqsf/publication/hafmd2-2/hafmd2-2.pdf\",\"EBookPath\":\"\",\"RescindOrg\":\"HQSF\",\"RescindDsnPhone\":\"314\",\"RescindCommPhone\":\"5713723608\",\"RescindLevel\":\"United States Space Force\",\"CertDate\":\"\\/Date(1679284800000)\\/\",\"GMDate\":null,\"CustomDetail\":false,\"DownloadUrl\":\"https://static.e-publishing.af.mil\",\"DocumentUrl\":\"https://static.e-publishing.af.mil/production/1/hqsf/publication/hafmd2-2/hafmd2-2.pdf\",\"EBookUrl\":\"https://static.e-publishing.af.mil\",\"FormatLetter\":\"E\",\"FormatClass\":\"label-danger\"},{\"PubID\":91318,\"Number\":\"HAFMD2-5\",\"Title\":\"DEPUTY CHIEF OF SPACE OPERATIONS FOR OPERATIONS, CYBER, AND NUCLEAR\",\"Prescribe\":\"\",\"LastAction\":\"Correction\",\"LastActionDate\":\"\\/Date(1727199931570)\\/\",\"ReplacementID\":0,\"Format\":0,\"ProductType\":0,\"Date\":\"\\/Date(1681704000000)\\/\",\"DocumentPath\":\"/production/1/hqsf/publication/hafmd2-5/hafmd2-5.pdf\",\"EBookPath\":\"\",\"RescindOrg\":\"HQSF\",\"RescindDsnPhone\":\"3126939488\",\"RescindCommPhone\":\"7036939488\",\"RescindLevel\":\"United States Space Force\",\"CertDate\":\"\\/Date(1681704000000)\\/\",\"GMDate\":null,\"CustomDetail\":false,\"DownloadUrl\":\"https://static.e-publishing.af.mil\",\"DocumentUrl\":\"https://static.e-publishing.af.mil/production/1/hqsf/publication/hafmd2-5/hafmd2-5.pdf\",\"EBookUrl\":\"https://static.e-publishing.af.mil\",\"FormatLetter\":\"E\",\"FormatClass\":\"label-danger\"},{\"PubID\":91330,\"Number\":\"HAFMD2-4\",\"Title\":\"DEPUTY CHIEF OF SPACE OPERATIONS FOR INTELLIGENCE\",\"Prescribe\":\"\",\"LastAction\":\"\",\"LastActionDate\":\"\\/Date(1682366734547)\\/\",\"ReplacementID\":0,\"Format\":0,\"ProductType\":0,\"Date\":\"\\/Date(1682308800000)\\/\",\"DocumentPath\":\"/production/1/hqsf/publication/hafmd2-4/hafmd2-4.pdf\",\"EBookPath\":\"\",\"RescindOrg\":\"HQSF\",\"RescindDsnPhone\":\"314\",\"RescindCommPhone\":\"5713723608\",\"RescindLevel\":\"United States Space Force\",\"CertDate\":\"\\/Date(1682308800000)\\/\",\"GMDate\":null,\"CustomDetail\":false,\"DownloadUrl\":\"https://static.e-publishing.af.mil\",\"DocumentUrl\":\"https://static.e-publishing.af.mil/production/1/hqsf/publication/hafmd2-4/hafmd2-4.pdf\",\"EBookUrl\":\"https://static.e-publishing.af.mil\",\"FormatLetter\":\"E\",\"FormatClass\":\"label-danger\"},{\"PubID\":91372,\"Number\":\"HAFMD2-7\",\"Title\":\"DEPUTY CHIEF OF SPACE OPERATIONS FOR TECHNOLOGY AND INNOVATION\",\"Prescribe\":\"\",\"LastAction\":\"\",\"LastActionDate\":\"\\/Date(1684441331970)\\/\",\"ReplacementID\":0,\"Format\":0,\"ProductType\":0,\"Date\":\"\\/Date(1684382400000)\\/\",\"DocumentPath\":\"/production/1/hqsf/publication/hafmd2-7/hafmd2-7.pdf\",\"EBookPath\":\"\",\"RescindOrg\":\"HQSF\",\"RescindDsnPhone\":\"3142230600\",\"RescindCommPhone\":\"7036930600\",\"RescindLevel\":\"United States Space Force\",\"CertDate\":\"\\/Date(1684382400000)\\/\",\"GMDate\":null,\"CustomDetail\":false,\"DownloadUrl\":\"https://static.e-publishing.af.mil\",\"DocumentUrl\":\"https://static.e-publishing.af.mil/production/1/hqsf/publication/hafmd2-7/hafmd2-7.pdf\",\"EBookUrl\":\"https://static.e-publishing.af.mil\",\"FormatLetter\":\"E\",\"FormatClass\":\"label-danger\"},{\"PubID\":127650,\"Number\":\"SPFMD4\",\"Title\":\"SPACE TRAINING AND READINESS COMMAND (STARCOM)\",\"Prescribe\":\"\",\"LastAction\":\"\",\"LastActionDate\":\"\\/Date(1689709256647)\\/\",\"ReplacementID\":0,\"Format\":0,\"ProductType\":0,\"Date\":\"\\/Date(1689652800000)\\/\",\"DocumentPath\":\"/production/1/hqsf/publication/spfmd4/spfmd4.pdf\",\"EBookPath\":\"\",\"RescindOrg\":\"HQSF\",\"RescindDsnPhone\":\"314\",\"RescindCommPhone\":\"7036933461\",\"RescindLevel\":\"United States Space Force\",\"CertDate\":\"\\/Date(1689652800000)\\/\",\"GMDate\":null,\"CustomDetail\":false,\"DownloadUrl\":\"https://static.e-publishing.af.mil\",\"DocumentUrl\":\"https://static.e-publishing.af.mil/production/1/hqsf/publication/spfmd4/spfmd4.pdf\",\"EBookUrl\":\"https://static.e-publishing.af.mil\",\"FormatLetter\":\"E\",\"FormatClass\":\"label-danger\"},{\"PubID\":174835,\"Number\":\"HAFMD2-1\",\"Title\":\"CHIEF OF SPACE OPERATIONS\",\"Prescribe\":\"\",\"LastAction\":\"Correction\",\"LastActionDate\":\"\\/Date(1700055943697)\\/\",\"ReplacementID\":0,\"Format\":0,\"ProductType\":0,\"Date\":\"\\/Date(1699419600000)\\/\",\"DocumentPath\":\"/production/1/hqsf/publication/hafmd2-1/hafmd2-1.pdf\",\"EBookPath\":\"/production/1/hqsf/publication/hafmd2-1/hafmd2-1.epub\",\"RescindOrg\":\"HQSF\",\"RescindDsnPhone\":\"314\",\"RescindCommPhone\":\"5713723608\",\"RescindLevel\":\"United States Space Force\",\"CertDate\":\"\\/Date(1699419600000)\\/\",\"GMDate\":null,\"CustomDetail\":false,\"DownloadUrl\":\"https://static.e-publishing.af.mil\",\"DocumentUrl\":\"https://static.e-publishing.af.mil/production/1/hqsf/publication/hafmd2-1/hafmd2-1.pdf\",\"EBookUrl\":\"https://static.e-publishing.af.mil/production/1/hqsf/publication/hafmd2-1/hafmd2-1.epub\",\"FormatLetter\":\"E\",\"FormatClass\":\"label-danger\"},{\"PubID\":181884,\"Number\":\"HAFMD2-3\",\"Title\":\"Deputy Chief of Space Operations for Human Capital\",\"Prescribe\":\"\",\"LastAction\":\"IC\",\"LastActionDate\":\"\\/Date(1769797946033)\\/\",\"ReplacementID\":0,\"Format\":0,\"ProductType\":0,\"Date\":\"\\/Date(1703134800000)\\/\",\"DocumentPath\":\"/production/1/hqsf/publication/hafmd2-3/hafmd2-3.pdf\",\"EBookPath\":\"/production/1/hqsf/publication/hafmd2-3/hafmd2-3.epub\",\"RescindOrg\":\"HQSF\",\"RescindDsnPhone\":\"3122235825\",\"RescindCommPhone\":\"7035712066\",\"RescindLevel\":\"United States Space Force\",\"CertDate\":\"\\/Date(1703134800000)\\/\",\"GMDate\":null,\"CustomDetail\":false,\"DownloadUrl\":\"https://static.e-publishing.af.mil\",\"DocumentUrl\":\"https://static.e-publishing.af.mil/production/1/hqsf/publication/hafmd2-3/hafmd2-3.pdf\",\"EBookUrl\":\"https://static.e-publishing.af.mil/production/1/hqsf/publication/hafmd2-3/hafmd2-3.epub\",\"FormatLetter\":\"E\",\"FormatClass\":\"label-danger\"},{\"PubID\":230881,\"Number\":\"HAFMD2-6\",\"Title\":\"DEPUTY CHIEF OF SPACE OPERATIONS FOR STRATEGY, PLANS, PROGRAMS, AND REQUIREMENTS\",\"Prescribe\":\"\",\"LastAction\":\"\",\"LastActionDate\":\"\\/Date(1715789159357)\\/\",\"ReplacementID\":0,\"Format\":0,\"ProductType\":0,\"Date\":\"\\/Date(1715745600000)\\/\",\"DocumentPath\":\"/production/1/hqsf/publication/hafmd2-6/hafmd2-6.pdf\",\"EBookPath\":\"/production/1/hqsf/publication/hafmd2-6/hafmd2-6.epub\",\"RescindOrg\":\"HQSF\",\"RescindDsnPhone\":\"3122232280\",\"RescindCommPhone\":\"7036932280\",\"RescindLevel\":\"United States Space Force\",\"CertDate\":\"\\/Date(1715745600000)\\/\",\"GMDate\":null,\"CustomDetail\":false,\"DownloadUrl\":\"https://static.e-publishing.af.mil\",\"DocumentUrl\":\"https://static.e-publishing.af.mil/production/1/hqsf/publication/hafmd2-6/hafmd2-6.pdf\",\"EBookUrl\":\"https://static.e-publishing.af.mil/production/1/hqsf/publication/hafmd2-6/hafmd2-6.epub\",\"FormatLetter\":\"E\",\"FormatClass\":\"label-danger\"},{\"PubID\":269055,\"Number\":\"SPFI36-2672\",\"Title\":\"SkillBridge Program\",\"Prescribe\":\"\",\"LastAction\":\"\",\"LastActionDate\":\"\\/Date(1774979430847)\\/\",\"ReplacementID\":0,\"Format\":0,\"ProductType\":0,\"Date\":\"\\/Date(1774929600000)\\/\",\"DocumentPath\":\"/production/1/hqsf/publication/spfi36-2672/spfi36-2672.pdf\",\"EBookPath\":\"/production/1/hqsf/publication/spfi36-2672/spfi36-2672.epub\",\"RescindOrg\":\"HQSF\",\"RescindDsnPhone\":\"3122247160\",\"RescindCommPhone\":\"7036935821\",\"RescindLevel\":\"United States Space Force\",\"CertDate\":\"\\/Date(1774929600000)\\/\",\"GMDate\":null,\"CustomDetail\":false,\"DownloadUrl\":\"https://static.e-publishing.af.mil\",\"DocumentUrl\":\"https://static.e-publishing.af.mil/production/1/hqsf/publication/spfi36-2672/spfi36-2672.pdf\",\"EBookUrl\":\"https://static.e-publishing.af.mil/production/1/hqsf/publication/spfi36-2672/spfi36-2672.epub\",\"FormatLetter\":\"E\",\"FormatClass\":\"label-danger\"}],\r\n        },\r\n        mounted: function () {\r\n            // Cant init the datatable framework until vue has mounted. This is much better than just\r\n            // setting the setInterval method to fire after some many milliseconds. A lag in\r\n            // rendering would cause the table to display not using the DataTables framework.\r\n            const table = this.initPublicationTable();\r\n            const vueScope = this;\r\n            $('.epubs-table').on('click', '.epub-details', function () {\r\n                // The DOM for mobile vs desktop are constructed differently\r\n                const rowIndex = ($(this).parents('ul').parents('tr').prev().length) ? \r\n                                  table.row($(this).parents('ul').parents('tr').prev()).index() :\r\n                                  table.row($(this).parents('tr')).index();\r\n                const pub = vueScope.publications[rowIndex];\r\n                epubs.ShowPubDetail(pub.PubID , -1, pub.ProductType, 449, 131);\r\n            });\r\n        }\r\n    });\r\n</script>\r\n"
