          "content": {
            "size": 9350,
            "mimeType": "text/html",
            "text": "<ol class=\"breadcrumb\">\r\n    <li><a href=\"#\" onclick=\"epubs.ShowMainNav(); return false;\">EPUBS Home</a></li>\r\n    <li><a href=\"#\" onclick=\"epubs.SelectCat(4, 'Field Operating Agencies'); return false;\" class=\"bc-cat\">Field Operating Agencies</a></li>\r\n    <li><a href=\"#\" onclick=\"epubs.ShowCurrentSeries(); return false;\" class=\"bc-org\">National Air and Space Intelligence Center</a></li>\r\n    <li class=\"active bc-series\"></li>\r\n</ol>\r\n\r\n<pub-search-list :publications=\"publications\" />\r\n\r\n<script type=\"text/javascript\">\r\n    Vue.component('pub-search-list', {\r\n        props: ['publications'],\r\n        \r\n        template:\r\n        \"<table id='data' class='epubs-table' style='width:100%'>\" +\r\n        \"    <thead>\" +\r\n        \"       <tr>\" +\r\n        \"            <th class='pnum'>Product Number</th>\" +\r\n        \"            <th class='desktop tablet-l ptitle'>Product Title</th>\" +\r\n        \"            <th class='desktop tablet-l'>Published</th>\" +\r\n        \"            <th class='desktop tablet-l'>Certified Current</th>\" +\r\n        \"            <th class='desktop tablet-l'>Last Action</th>\" +\r\n        \"            <th class='desktop tablet-l'>GM Date</th>\" +\r\n        \"        </tr>\" +\r\n        \"    </thead>\" +\r\n        \"     <tbody>\" +\r\n        \"        <tr v-for='(pub, index) in publications'>\" +\r\n        \"            <td>{{pub.Number}} \" +\r\n        \"                <a target='_blank' rel='noreferrer noopener' :href='pub.DocumentUrl' style='border-bottom:none;' :aria-label=\\\"'PDF of ' + pub.Title\\\" title='Download PDF'><span class='epub-download fa-stack fa-1x'><i class='fas fa-file-pdf fa-stack-2x pdf-icon' ></i><i class='fas fa-arrow-alt-circle-down fa-stack-1x'></i></span></a> \" + \r\n        \"                <a target='_blank' rel='noreferrer noopener' :href='pub.EBookUrl' v-if='pub.EBookPath' style='border-bottom:none;' :aria-label=\\\"'Ebook of ' + pub.Title\\\" title='Download Ebook'><span class='epub-download fa-stack fa-1x'><img src='../DesktopModules/MVC/EPUBS/Resources/ebook/ico_ebook.png' alt='' /><i class='fas fa-arrow-alt-circle-down fa-stack-1x'></i></span></a></td>\" +\r\n        \"            <td><a target='#' class='epub-details' title='View Detail'>{{pub.Title}}</a> </td>\" +\r\n        \"            <td>\" +\r\n        \"                <span class='hide'>{{ pub.Date | formatDate(true) }}</span>\" +\r\n        \"                {{ pub.Date | formatDate(false) }}\" +\r\n        \"            </td>\" +\r\n        \"            <td>\" +\r\n        \"                <span class='hide'>{{ pub.CertDate | formatDate(true) }}</span>\" +\r\n        \"                {{ pub.CertDate | formatDate(false) }}\" +\r\n        \"            </td>\"  +\r\n        \"            <td>{{ pub.LastAction }}</td>\" +\r\n        \"            <td>\" +\r\n        \"                <span class='hide'> {{ pub.LastAction | formatLastAction( pub.GMDate, true) }}</span>\" +\r\n        \"                {{ pub.LastAction | formatLastAction( pub.GMDate, false) }}\" +\r\n        \"            </td>\" +\r\n        \"        </tr>\" +\r\n        \"    </tbody>\" +\r\n        \"</table>\"\r\n    });\r\n\r\n\r\n    Vue.filter('formatDate', function (value, hidden) {\r\n        if (value) {\r\n            var longTime = value.match(/\\d+/)[0] * 1;\r\n            var pubDate = new Date(longTime);\r\n            if (hidden)\r\n                return moment(pubDate).format(\"YYYYMMDD\");\r\n            else\r\n                return moment(pubDate).format(\"DD MMM YYYY\");\r\n        }\r\n\r\n        return \"\";\r\n    });\r\n\r\n    Vue.filter('formatLastAction', function (value, lastActionDate, hidden) {\r\n        if (lastActionDate) {\r\n            var longTime = lastActionDate.match(/\\d+/)[0] * 1;\r\n            var pubDate = new Date(longTime);\r\n            if (hidden)\r\n                return moment(pubDate).format(\"YYYYMMDD\");\r\n            else\r\n                return moment(pubDate).format(\"DD MMM YYYY\");\r\n        }\r\n\r\n        return \"\";\r\n    });\r\n\r\n    var pubSearchApp = new Vue({\r\n        el: '#pub-list',\r\n        component: ['pub-search-list'],\r\n        methods: {\r\n            initPublicationTable: function () {\r\n                return $('#data').DataTable({\r\n                        \"responsive\": true,\r\n                        \"authWidth\": false,\r\n                        \"columnDefs\": [\r\n                            { responsivePriority: 1, targets: 1 },\r\n                            { responsivePriority: 1, targets: 2 }\r\n                        ],\r\n                        \"columns\": [\r\n                            { \"width\": \"15%\", className: \"pubid\" },\r\n                            { \"width\": \"40%\" },\r\n                            null,\r\n                            null,\r\n                            null,\r\n                            null\r\n                        ],\r\n                        \"oLanguage\": {\r\n                            \"sSearch\": \"Filter\"\r\n                        }\r\n                });\r\n            },\r\n        },\r\n        data: {\r\n            publications: [{\"PubID\":39754,\"Number\":\"AFI25-201_NASICSUP_I\",\"Title\":\"INTRA-SERVICE, INTRA-AGENCY, AND INTER-AGENCY SUPPORT AGREEMENT PROCEDURES\",\"Prescribe\":\"\",\"LastAction\":\"CertifiedCurrent\",\"LastActionDate\":\"\\/Date(1537383834770)\\/\",\"ReplacementID\":0,\"Format\":0,\"ProductType\":0,\"Date\":\"\\/Date(1414990800000)\\/\",\"DocumentPath\":\"/production/1/nasic/publication/afi25-201_nasicsup_i/afi25-201_nasicsup.pdf\",\"EBookPath\":\"\",\"RescindOrg\":\"NASIC\",\"RescindDsnPhone\":\"3127874229\",\"RescindCommPhone\":\"9372574229\",\"RescindLevel\":\"Field Operating Agency\",\"CertDate\":\"\\/Date(1537329600000)\\/\",\"GMDate\":null,\"CustomDetail\":false,\"DownloadUrl\":\"https://static.e-publishing.af.mil\",\"DocumentUrl\":\"https://static.e-publishing.af.mil/production/1/nasic/publication/afi25-201_nasicsup_i/afi25-201_nasicsup.pdf\",\"EBookUrl\":\"https://static.e-publishing.af.mil\",\"FormatLetter\":\"E\",\"FormatClass\":\"label-danger\"},{\"PubID\":88236,\"Number\":\"NASICI33-106-O\",\"Title\":\"USE OF HUMINT CONTROL SYSTEM AND GAMMA INFORMATION ON NASIC CORNERSTONE TOP SECRET NETWORK\",\"Prescribe\":\"\",\"LastAction\":\"Rewrite\",\"LastActionDate\":\"\\/Date(1558619256797)\\/\",\"ReplacementID\":0,\"Format\":0,\"ProductType\":0,\"Date\":\"\\/Date(1558584000000)\\/\",\"DocumentPath\":\"/production/1/nasic/publication/nasici33-106-o/for_official_use_only.pdf\",\"EBookPath\":\"\",\"RescindOrg\":\"NASIC\",\"RescindDsnPhone\":\"3127872847\",\"RescindCommPhone\":\"9372572847\",\"RescindLevel\":\"Field Operating Agency\",\"CertDate\":\"\\/Date(1558584000000)\\/\",\"GMDate\":null,\"CustomDetail\":false,\"DownloadUrl\":\"https://static.e-publishing.af.mil\",\"DocumentUrl\":\"https://static.e-publishing.af.mil/production/1/nasic/publication/nasici33-106-o/for_official_use_only.pdf\",\"EBookUrl\":\"https://static.e-publishing.af.mil\",\"FormatLetter\":\"E\",\"FormatClass\":\"label-danger\"},{\"PubID\":90131,\"Number\":\"NASICI10-245-O\",\"Title\":\"NASIC ANTITERRORISM PROGRAM\",\"Prescribe\":\"\",\"LastAction\":\"UpdateContact\",\"LastActionDate\":\"\\/Date(1734017900533)\\/\",\"ReplacementID\":0,\"Format\":0,\"ProductType\":0,\"Date\":\"\\/Date(1630296000000)\\/\",\"DocumentPath\":\"/production/1/nasic/publication/nasici10-245-o/nasici10-245-o.pdf\",\"EBookPath\":\"\",\"RescindOrg\":\"NASIC\",\"RescindDsnPhone\":\"3127872847\",\"RescindCommPhone\":\"9372572847\",\"RescindLevel\":\"Field Operating Agency\",\"CertDate\":\"\\/Date(1630296000000)\\/\",\"GMDate\":null,\"CustomDetail\":false,\"DownloadUrl\":\"https://static.e-publishing.af.mil\",\"DocumentUrl\":\"https://static.e-publishing.af.mil/production/1/nasic/publication/nasici10-245-o/nasici10-245-o.pdf\",\"EBookUrl\":\"https://static.e-publishing.af.mil\",\"FormatLetter\":\"E\",\"FormatClass\":\"label-danger\"},{\"PubID\":90216,\"Number\":\"DAFI36-2670_NASICSUP\",\"Title\":\"TOTAL FORCE DEVELOPMENT\",\"Prescribe\":\"\",\"LastAction\":\"UpdateContact\",\"LastActionDate\":\"\\/Date(1734018024537)\\/\",\"ReplacementID\":0,\"Format\":0,\"ProductType\":0,\"Date\":\"\\/Date(1634097600000)\\/\",\"DocumentPath\":\"/production/1/nasic/publication/dafi36-2670_nasicsup/dafi36-2670_nasicsup.pdf\",\"EBookPath\":\"\",\"RescindOrg\":\"NASIC\",\"RescindDsnPhone\":\"3125224692\",\"RescindCommPhone\":\"9377131304\",\"RescindLevel\":\"Field Operating Agency\",\"CertDate\":\"\\/Date(1634097600000)\\/\",\"GMDate\":null,\"CustomDetail\":false,\"DownloadUrl\":\"https://static.e-publishing.af.mil\",\"DocumentUrl\":\"https://static.e-publishing.af.mil/production/1/nasic/publication/dafi36-2670_nasicsup/dafi36-2670_nasicsup.pdf\",\"EBookUrl\":\"https://static.e-publishing.af.mil\",\"FormatLetter\":\"E\",\"FormatClass\":\"label-danger\"}],\r\n        },\r\n        mounted: function () {\r\n            // Cant init the datatable framework until vue has mounted. This is much better than just\r\n            // setting the setInterval method to fire after some many milliseconds. A lag in\r\n            // rendering would cause the table to display not using the DataTables framework.\r\n            const table = this.initPublicationTable();\r\n            const vueScope = this;\r\n            $('.epubs-table').on('click', '.epub-details', function () {\r\n                // The DOM for mobile vs desktop are constructed differently\r\n                const rowIndex = ($(this).parents('ul').parents('tr').prev().length) ? \r\n                                  table.row($(this).parents('ul').parents('tr').prev()).index() :\r\n                                  table.row($(this).parents('tr')).index();\r\n                const pub = vueScope.publications[rowIndex];\r\n                epubs.ShowPubDetail(pub.PubID , -1, pub.ProductType, 449, 131);\r\n            });\r\n        }\r\n    });\r\n</script>\r\n"
          },
