            "text": "<ol class=\"breadcrumb\">\r\n    <li><a href=\"#\" onclick=\"epubs.ShowMainNav(); return false;\">EPUBS Home</a></li>\r\n    <li><a href=\"#\" onclick=\"epubs.SelectCat(5, 'Numbered Air Forces'); return false;\" class=\"bc-cat\">Numbered Air Forces</a></li>\r\n    <li class=\"active bc-org\">Fifth Air Force</li>\r\n</ol>\r\n    <div class=\"col-lg-12\">\r\n        <h4>Select Publication Series</h4>\r\n        <ul style=\"column-count:2\">\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"ALL PUBLICATIONS\" href=\"#\" onclick=\"epubs.SelectPubs(9621, 5, -1,'ALL PUBLICATIONS', 449, 131);return false;\">00 &nbsp;&nbsp;ALL PUBLICATIONS</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Services\" href=\"#\" onclick=\"epubs.SelectPubs(9621, 5, 17,'Services', 449, 131);return false;\">34 &nbsp;&nbsp;Services</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Personnel\" href=\"#\" onclick=\"epubs.SelectPubs(9621, 5, 19,'Personnel', 449, 131);return false;\">36 &nbsp;&nbsp;Personnel</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Law\" href=\"#\" onclick=\"epubs.SelectPubs(9621, 5, 28,'Law', 449, 131);return false;\">51 &nbsp;&nbsp;Law</a></li>\r\n        </ul>\r\n    </div>\r\n\r\n"
