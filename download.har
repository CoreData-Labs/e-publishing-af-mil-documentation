            "text": "<ol class=\"breadcrumb\">\r\n    <li><a href=\"#\" onclick=\"epubs.ShowMainNav(); return false;\">EPUBS Home</a></li>\r\n    <li><a href=\"#\" onclick=\"epubs.SelectCat(18, 'Lead Commands'); return false;\" class=\"bc-cat\">Lead Commands</a></li>\r\n    <li class=\"active bc-org\">LC - Air Combat Command</li>\r\n</ol>\r\n    <div class=\"col-lg-12\">\r\n        <h4>Select Publication Series</h4>\r\n        <ul style=\"column-count:2\">\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"ALL PUBLICATIONS\" href=\"#\" onclick=\"epubs.SelectPubs(16062, 18, -1,'ALL PUBLICATIONS', 449, 131);return false;\">00 &nbsp;&nbsp;ALL PUBLICATIONS</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Maintenance\" href=\"#\" onclick=\"epubs.SelectPubs(16062, 18, 10,'Maintenance', 449, 131);return false;\">21 &nbsp;&nbsp;Maintenance</a></li>\r\n        </ul>\r\n    </div>\r\n\r\n"
