            "text": "<ol class=\"breadcrumb\">\r\n    <li><a href=\"#\" onclick=\"epubs.ShowMainNav(); return false;\">EPUBS Home</a></li>\r\n    <li><a href=\"#\" onclick=\"epubs.SelectCat(5, 'Numbered Air Forces'); return false;\" class=\"bc-cat\">Numbered Air Forces</a></li>\r\n    <li class=\"active bc-org\">Second Air Force</li>\r\n</ol>\r\n    <div class=\"col-lg-12\">\r\n        <h4>Select Publication Series</h4>\r\n        <ul style=\"column-count:2\">\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"ALL PUBLICATIONS\" href=\"#\" onclick=\"epubs.SelectPubs(9618, 5, -1,'ALL PUBLICATIONS', 449, 131);return false;\">00 &nbsp;&nbsp;ALL PUBLICATIONS</a></li>\r\n                <li><span class=\"fa fa-angle-double-right\"></span><a title=\"Personnel\" href=\"#\" onclick=\"epubs.SelectPubs(9618, 5, 19,'Personnel', 449, 131);return false;\">36 &nbsp;&nbsp;Personnel</a></li>\r\n        </ul>\r\n    </div>\r\n        <div style=\"clear:both\"></div>\r\n        <div class=\"col-lg-12\">\r\n            <h4>Special Publications</h4>\r\n            <ul style=\"column-count:2\">\r\n                    <li><span class=\"fa fa-angle-double-right\"></span><a href=\"#\" title=\"Career Field Education and Training Plan\" onclick=\"epubs.SelectPubs(9618, 5, 86, 'Career Field Education and Training Plan', 449, 131);return false;\">CFETP &nbsp;&nbsp;Career Field Education and Training Plan</a></li>\r\n            </ul>\r\n        </div>\r\n\r\n"
