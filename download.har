            "size": 14094,
            "mimeType": "text/html",
            "text": "<ol class=\"breadcrumb\">\r\n    <li><a href=\"#\" onclick=\"epubs.ShowMainNav(); return false;\">EPUBS Home</a></li>\r\n    <li><a href=\"#\" onclick=\"epubs.SelectCat(20, 'United States Space Force'); return false;\" class=\"bc-cat\">United States Space Force</a></li>\r\n    <li><a href=\"#\" onclick=\"epubs.ShowCurrentSeries(); return false;\" class=\"bc-org\">United States Space Force</a></li>\r\n    <li class=\"active bc-series\"></li>\r\n</ol>\r\n\r\n<pub-search-list :publications=\"publications\" />\r\n\r\n<script type=\"text/javascript\">\r\n    Vue.component('pub-search-list', {\r\n        props: ['publications'],\r\n        \r\n        template:\r\n        \"<table id='data' class='epubs-table' style='width:100%'>\" +\r\n        \"    <thead>\" +\r\n        \"       <tr>\" +\r\n        \"            <th class='pnum'>Product Number</th>\" +\r\n        \"            <th class='desktop tablet-l ptitle'>Product Title</th>\" +\r\n        \"            <th class='desktop tablet-l'>Published</th>\" +\r\n        \"            <th class='desktop tablet-l'>Certified Current</th>\" +\r\n        \"            <th class='desktop tablet-l'>Last Action</th>\" +\r\n        \"            <th class='desktop tablet-l'>GM Date</th>\" +\r\n        \"        </tr>\" +\r\n        \"    </thead>\" +\r\n        \"     <tbody>\" +\r\n        \"        <tr v-for='(pub, index) in publications'>\" +\r\n        \"            <td>{{pub.Number}} \" +\r\n        \"                <a target='_blank' rel='noreferrer noopener' :href='pub.DocumentUrl' style='border-bottom:none;' :aria-label=\\\"'PDF of ' + pub.Title\\\" title='Download PDF'><span class='epub-download fa-stack fa-1x'><i class='fas fa-file-pdf fa-stack-2x pdf-icon' ></i><i class='fas fa-arrow-alt-circle-down fa-stack-1x'></i></span></a> \" + \r\n        \"                <a target='_blank' rel='noreferrer noopener' :href='pub.EBookUrl' v-if='pub.EBookPath' style='border-bottom:none;' :aria-label=\\\"'Ebook of ' + pub.Title\\\" title='Download Ebook'><span class='epub-download fa-stack fa-1x'><img src='../DesktopModules/MVC/EPUBS/Resources/ebook/ico_ebook.png' alt='' /><i class='fas fa-arrow-alt-circle-down fa-stack-1x'></i></span></a></td>\" +\r\n        \"            <td><a target='#' class='epub-details' title='View Detail'>{{pub.Title}}</a> </td>\" +\r\n        \"            <td>\" +\r\n        \"                <span class='hide'>{{ pub.Date | formatDate(true) }}</span>\" +\r\n        \"                {{ pub.Date | formatDate(false) }}\" +\r\n        \"            </td>\" +\r\n        \"            <td>\" +\r\n        \"                <span class='hide'>{{ pub.CertDate | formatDate(true) }}</span>\" +\r\n        \"                {{ pub.CertDate | formatDate(false) }}\" +\r\n        \"            </td>\"  +\r\n        \"            <td>{{ pub.LastAction }}</td>\" +\r\n        \"            <td>\" +\r\n        \"                <span class='hide'> {{ pub.LastAction | formatLastAction( pub.GMDate, true) }}</span>\" +\r\n        \"                {{ pub.LastAction | formatLastAction( pub.GMDate, false) }}\" +\r\n        \"            </td>\" +\r\n        \"        </tr>\" +\r\n        \"    </tbody>\" +\r\n        \"</table>\"\r\n    });\r\n\r\n\r\n    Vue.filter('formatDate', function (value, hidden) {\r\n        if (value) {\r\n            var longTime = value.match(/\\d+/)[0] * 1;\r\n            var pubDate = new Date(longTime);\r\n            if (hidden)\r\n                return moment(pubDate).format(\"YYYYMMDD\");\r\n            else\r\n                return moment(pubDate).format(\"DD MMM YYYY\");\r\n        }\r\n\r\n        return \"\";\r\n    });\r\n\r\n    Vue.filter('formatLastAction', function (value, lastActionDate, hidden) {\r\n        if (lastActionDate) {\r\n            var longTime = lastActionDate.match(/\\d+/)[0] * 1;\r\n            var pubDate = new Date(longTime);\r\n            if (hidden)\r\n                return moment(pubDate).format(\"YYYYMMDD\");\r\n            else\r\n                return moment(pubDate).format(\"DD MMM YYYY\");\r\n        }\r\n\r\n        return \"\";\r\n    });\r\n\r\n    var pubSearchApp = new Vue({\r\n        el: '#pub-list',\r\n        component: ['pub-search-list'],\r\n        methods: {\r\n            initPublicationTable: function () {\r\n                return $('#data').DataTable({\r\n                        \"responsive\": true,\r\n                        \"authWidth\": false,\r\n                        \"columnDefs\": [\r\n                            { responsivePriority: 1, targets: 1 },\r\n                            { responsivePriority: 1, targets: 2 }\r\n                        ],\r\n                        \"columns\": [\r\n                            { \"width\": \"15%\", className: \"pubid\" },\r\n                            { \"width\": \"40%\" },\r\n                            null,\r\n                            null,\r\n                            null,\r\n                            null\r\n                        ],\r\n                        \"oLanguage\": {\r\n                            \"sSearch\": \"Filter\"\r\n                        }\r\n                });\r\n            },\r\n        },\r\n        data: {\r\n            publications: [{\"PubID\":91273,\"Number\":\"SPFH1-1\",\"Title\":\"GUARDIAN SPIRIT\",\"Prescribe\":\"\",\"LastAction\":\"Correction\",\"LastActionDate\":\"\\/Date(1709647960427)\\/\",\"ReplacementID\":0,\"Format\":0,\"ProductType\":0,\"Date\":\"\\/Date(1680494400000)\\/\",\"DocumentPath\":\"/production/1/ussf/publication/spfh1-1/spfh1-1.pdf\",\"EBookPath\":\"\",\"RescindOrg\":\"USSF\",\"RescindDsnPhone\":\"314\",\"RescindCommPhone\":\"6232613561\",\"RescindLevel\":\"United States Space Force\",\"CertDate\":\"\\/Date(1680494400000)\\/\",\"GMDate\":null,\"CustomDetail\":false,\"DownloadUrl\":\"https://static.e-publishing.af.mil\",\"DocumentUrl\":\"https://static.e-publishing.af.mil/production/1/ussf/publication/spfh1-1/spfh1-1.pdf\",\"EBookUrl\":\"https://static.e-publishing.af.mil\",\"FormatLetter\":\"E\",\"FormatClass\":\"label-danger\"},{\"PubID\":173826,\"Number\":\"SPFMAN10-406\",\"Title\":\"UNIT TYPE CODE MANAGEMENT\",\"Prescribe\":\"\",\"LastAction\":\"Correction\",\"LastActionDate\":\"\\/Date(1708029543053)\\/\",\"ReplacementID\":0,\"Format\":0,\"ProductType\":0,\"Date\":\"\\/Date(1698897600000)\\/\",\"DocumentPath\":\"/production/1/ussf/publication/spfman10-406/spfman10-406.pdf\",\"EBookPath\":\"\",\"RescindOrg\":\"USSF\",\"RescindDsnPhone\":\"314\",\"RescindCommPhone\":\"7035455101\",\"RescindLevel\":\"United States Space Force\",\"CertDate\":\"\\/Date(1698897600000)\\/\",\"GMDate\":null,\"CustomDetail\":false,\"DownloadUrl\":\"https://static.e-publishing.af.mil\",\"DocumentUrl\":\"https://static.e-publishing.af.mil/production/1/ussf/publication/spfman10-406/spfman10-406.pdf\",\"EBookUrl\":\"https://static.e-publishing.af.mil\",\"FormatLetter\":\"E\",\"FormatClass\":\"label-danger\"},{\"PubID\":253002,\"Number\":\"SPFMAN36-1001\",\"Title\":\"CIVILIAN RECOGNITION PROGRAM\",\"Prescribe\":\"\",\"LastAction\":\"IC\",\"LastActionDate\":\"\\/Date(1740748514997)\\/\",\"ReplacementID\":0,\"Format\":0,\"ProductType\":0,\"Date\":\"\\/Date(1721707200000)\\/\",\"DocumentPath\":\"/production/1/ussf/publication/spfman36-1001/spfman36-1001.pdf\",\"EBookPath\":\"\",\"RescindOrg\":\"USSF\",\"RescindDsnPhone\":\"314\",\"RescindCommPhone\":\"\",\"RescindLevel\":\"United States Space Force\",\"CertDate\":\"\\/Date(1721707200000)\\/\",\"GMDate\":null,\"CustomDetail\":false,\"DownloadUrl\":\"https://static.e-publishing.af.mil\",\"DocumentUrl\":\"https://static.e-publishing.af.mil/production/1/ussf/publication/spfman36-1001/spfman36-1001.pdf\",\"EBookUrl\":\"https://static.e-publishing.af.mil\",\"FormatLetter\":\"E\",\"FormatClass\":\"label-danger\"},{\"PubID\":260091,\"Number\":\"SPFI36-2502\",\"Title\":\"Enlisted Guardian Promotion and Demotion Programs\",\"Prescribe\":\"\",\"LastAction\":\"GM\",\"La